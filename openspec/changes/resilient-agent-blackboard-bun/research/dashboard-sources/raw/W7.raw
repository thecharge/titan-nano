,\"name\":\"Environment Variables\",\"description\":\"Langfuse has extensive configuration options via environment variables.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration\",\"$ref\":\"configuration/index.mdx\"},{\"$id\":\"self-hosting:configuration/scaling.mdx\",\"type\":\"page\",\"name\":\"Sizing \u0026 Scaling\",\"description\":\"Learn how to scale your self-hosted Langfuse deployment to handle more traffic and data.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/scaling\",\"$ref\":\"configuration/scaling.mdx\"},{\"$id\":\"self-hosting:configuration/hardening.mdx\",\"type\":\"page\",\"name\":\"Hardening\",\"description\":\"Operator-facing security knobs for self-hosted Langfuse — restrict sign-ups, enforce SSO, limit outbound URLs, and tighten admin access.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/hardening\",\"$ref\":\"configuration/hardening.mdx\"},{\"$id\":\"self-hosting:configuration/fips-mode.mdx\",\"type\":\"page\",\"name\":\"FIPS mode\",\"description\":\"Run self-hosted Langfuse Government on FIPS 140-3 validated cryptographic modules in approved mode.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/fips-mode\",\"$ref\":\"configuration/fips-mode.mdx\"},{\"$id\":\"self-hosting:configuration/backups.mdx\",\"type\":\"page\",\"name\":\"Backups\",\"description\":\"Comprehensive guide to backing up your self-hosted Langfuse deployment including ClickHouse, Postgres, and blob storage (SeaweedFS, MinIO).\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/backups\",\"$ref\":\"configuration/backups.mdx\"},{\"$id\":\"self-hosting:_1\",\"type\":\"separator\",\"icon\":\"$undefined\",\"name\":\"Advanced\"},{\"$id\":\"self-hosting:configuration/ai-gateway.mdx\",\"type\":\"page\",\"name\":\"AI Gateway\",\"description\":\"Deploy the Langfuse AI Gateway next to your self-hosted Langfuse with the Helm chart, and configure its public URL, TLS, scaling, health checks, and graceful shutdown.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/ai-gateway\",\"$ref\":\"configuration/ai-gateway.mdx\"},{\"$id\":\"self-hosting:configuration/caching.mdx\",\"type\":\"page\",\"name\":\"Caching\",\"description\":\"Langfuse provides caching for API keys and prompts to improve performance and reduce database load.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/caching\",\"$ref\":\"configuration/caching.mdx\"},{\"$id\":\"self-hosting:configuration/code-evaluators.mdx\",\"type\":\"page\",\"name\":\"Code evaluators\",\"description\":\"Configure dispatchers and workers for self-hosted code evaluator execution.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/code-evaluators\",\"$ref\":\"configuration/code-evaluators.mdx\"},{\"$id\":\"self-hosting:configuration/custom-base-path.mdx\",\"type\":\"page\",\"name\":\"Custom Base Path\",\"description\":\"Follow this guide to deploy Langfuse on a custom base path, e.g. https://yourdomain.com/langfuse.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/custom-base-path\",\"$ref\":\"configuration/custom-base-path.mdx\"},{\"$id\":\"self-hosting:configuration/encryption.mdx\",\"type\":\"page\",\"name\":\"Encryption\",\"description\":\"Learn how to encrypt your self-hosted Langfuse deployment. This guide covers encryption in transit (HTTPS), at rest (database) and application-level encryption.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/encryption\",\"$ref\":\"configuration/encryption.mdx\"},{\"$id\":\"self-hosting:configuration/health-readiness-endpoints.mdx\",\"type\":\"page\",\"name\":\"Health and Readiness Check\",\"description\":\"Monitor the health and readiness of your Langfuse self-hosted deployment\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/health-readiness-endpoints\",\"$ref\":\"configuration/health-readiness-endpoints.mdx\"},{\"$id\":\"self-hosting:configuration/halo.mdx\",\"type\":\"page\",\"name\":\"Halo\",\"description\":\"Configure the model, worker MCP access, and optional sandbox for the self-hosted Halo.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/halo\",\"$ref\":\"configuration/halo.mdx\"},{\"$id\":\"self-hosting:configuration/observability.mdx\",\"type\":\"page\",\"name\":\"Observability\",\"description\":\"You can use OpenTelemetry for observability into the Langfuse application.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/observability\",\"$ref\":\"configuration/observability.mdx\"},{\"$id\":\"self-hosting:configuration/transactional-emails.mdx\",\"type\":\"page\",\"name\":\"Transactional Emails\",\"description\":\"Learn how to configure transactional emails for your self-hosted Langfuse deployment.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/configuration/transactional-emails\",\"$ref\":\"configuration/transactional-emails.mdx\"}],\"$id\":\"self-hosting:configuration\",\"$ref\":{\"folder\":\"configuration\",\"meta\":\"configuration/meta.json\"},\"icon\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"Deployment\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"self-hosting:deployment/docker-compose.mdx\",\"type\":\"page\",\"name\":\"Local/VM (Docker Compose)\",\"description\":\"Step-by-step guide to deploy and run Langfuse locally or on a VM using Docker Compose. The simplest way to self-host Langfuse with Docker.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/docker-compose\",\"$ref\":\"deployment/docker-compose.mdx\"},{\"$id\":\"self-hosting:deployment/kubernetes-helm.mdx\",\"type\":\"page\",\"name\":\"Kubernetes (Helm)\",\"description\":\"Step-by-step guide to run Langfuse on Kubernetes via Helm.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/kubernetes-helm\",\"$ref\":\"deployment/kubernetes-helm.mdx\"},{\"$id\":\"self-hosting:deployment/aws.mdx\",\"type\":\"page\",\"name\":\"AWS (Terraform)\",\"description\":\"Step-by-step guide to run Langfuse on AWS via Terraform.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/aws\",\"$ref\":\"deployment/aws.mdx\"},{\"$id\":\"self-hosting:deployment/azure.mdx\",\"type\":\"page\",\"name\":\"Azure (Terraform)\",\"description\":\"Step-by-step guide to run Langfuse on Azure via Terraform.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/azure\",\"$ref\":\"deployment/azure.mdx\"},{\"$id\":\"self-hosting:deployment/gcp.mdx\",\"type\":\"page\",\"name\":\"GCP (Terraform)\",\"description\":\"Step-by-step guide to run Langfuse on GCP via Terraform.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/gcp\",\"$ref\":\"deployment/gcp.mdx\"},{\"$id\":\"self-hosting:deployment/render.mdx\",\"type\":\"page\",\"name\":\"Render\",\"description\":\"Use this guide to deploy Langfuse v4 at production scale on Render with a prebuilt Blueprint.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/render\",\"$ref\":\"deployment/render.mdx\"},{\"$id\":\"self-hosting:deployment/railway.mdx\",\"type\":\"page\",\"name\":\"Railway\",\"description\":\"Use this guide to deploy Langfuse v3 on Railway via the prebuilt template.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/railway\",\"$ref\":\"deployment/railway.mdx\"},{\"type\":\"folder\",\"name\":\"Infrastructure\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"self-hosting:_2\",\"type\":\"page\",\"icon\":\"$undefined\",\"name\":\"Architecture Overview ↗\",\"url\":\"/self-hosting#architecture\",\"external\":\"$undefined\"},{\"$id\":\"self-hosting:deployment/infrastructure/containers.mdx\",\"type\":\"page\",\"name\":\"Application Containers\",\"description\":\"Langfuse uses Docker to containerize the application. The application is split into two containers (Langfuse Web and Langfuse Worker).\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/infrastructure/containers\",\"$ref\":\"deployment/infrastructure/containers.mdx\"},{\"$id\":\"self-hosting:deployment/infrastructure/clickhouse.mdx\",\"type\":\"page\",\"name\":\"Clickhouse\",\"description\":\"Configure and host ClickHouse for self-hosted Langfuse. Covers ClickHouse server setup, cloud hosting options, Azure deployment, configuration best practices, and performance tuning.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/infrastructure/clickhouse\",\"$ref\":\"deployment/infrastructure/clickhouse.mdx\"},{\"$id\":\"self-hosting:deployment/infrastructure/cache.mdx\",\"type\":\"page\",\"name\":\"Redis / Valkey\",\"description\":\"Configure Redis or Valkey as a caching layer and queue for self-hosted Langfuse. Includes Redis environment variables, connection options, and configuration best practices.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/infrastructure/cache\",\"$ref\":\"deployment/infrastructure/cache.mdx\"},{\"$id\":\"self-hosting:deployment/infrastructure/blobstorage.mdx\",\"type\":\"page\",\"name\":\"Blob Storage (S3)\",\"description\":\"Configure S3 or S3-compatible blob storage for self-hosted Langfuse. Store raw events, multi-modal inputs, and batch exports with Amazon S3, Google Cloud Storage, Azure Blob Storage, SeaweedFS, MinIO, or compatible services.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/infrastructure/blobstorage\",\"$ref\":\"deployment/infrastructure/blobstorage.mdx\"},{\"$id\":\"self-hosting:deployment/infrastructure/postgres.mdx\",\"type\":\"page\",\"name\":\"PostgreSQL\",\"description\":\"Langfuse requires a persistent Postgres database to store its state.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/infrastructure/postgres\",\"$ref\":\"deployment/infrastructure/postgres.mdx\"},{\"$id\":\"self-hosting:deployment/infrastructure/llm-api.mdx\",\"type\":\"page\",\"name\":\"LLM API / Gateway\",\"description\":\"Optionally, you can configure Langfuse to use an external LLM API or gateway for add-on features. Langfuse tracing does not need access to the LLM API as traces are captured client-side.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/deployment/infrastructure/llm-api\",\"$ref\":\"deployment/infrastructure/llm-api.mdx\"}],\"$id\":\"self-hosting:deployment/infrastructure\",\"$ref\":{\"folder\":\"deployment/infrastructure\",\"meta\":\"deployment/infrastructure/meta.json\"},\"icon\":\"$undefined\"}],\"$id\":\"self-hosting:deployment\",\"$ref\":{\"folder\":\"deployment\",\"meta\":\"deployment/meta.json\"},\"icon\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"Security\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"self-hosting:security/authentication-and-sso.mdx\",\"type\":\"page\",\"name\":\"Authentication and SSO\",\"description\":\"Configure SSO (SAML, OIDC) and authentication for self-hosted Langfuse. Supports Google, GitHub, Azure AD, Okta, and custom OIDC/SAML providers.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/security/authentication-and-sso\",\"$ref\":\"security/authentication-and-sso.mdx\"},{\"$id\":\"self-hosting:security/deployment-strategies.mdx\",\"type\":\"page\",\"name\":\"Deployment Strategies\",\"description\":\"Learn how to manage Langfuse effectively. It covers strategies for handling multiple projects and environments.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/security/deployment-strategies\",\"$ref\":\"security/deployment-strategies.mdx\"},{\"$id\":\"self-hosting:security/networking.mdx\",\"type\":\"page\",\"name\":\"Networking\",\"description\":\"Learn how to configure networking for your self-hosted Langfuse deployment. Langfuse can be run without internet access.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/security/networking\",\"$ref\":\"security/networking.mdx\"},{\"$id\":\"self-hosting:_3\",\"type\":\"page\",\"icon\":\"$undefined\",\"name\":\"Hardening ↗\",\"url\":\"/self-hosting/configuration/hardening\",\"external\":\"$undefined\"},{\"$id\":\"self-hosting:security/data-masking.mdx\",\"type\":\"page\",\"name\":\"Data Masking\",\"description\":\"Configure data masking in your self-hosted Langfuse deployment to redact sensitive information from tracing events.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/security/data-masking\",\"$ref\":\"security/data-masking.mdx\"},{\"$id\":\"self-hosting:security/telemetry.mdx\",\"type\":\"page\",\"name\":\"Telemetry\",\"description\":\"Learn what telemetry Langfuse sends from self-hosted deployments, why it is collected, when it can be disabled, and which hostnames Langfuse contacts.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/security/telemetry\",\"$ref\":\"security/telemetry.mdx\"},{\"$id\":\"self-hosting:_4\",\"type\":\"page\",\"icon\":\"$undefined\",\"name\":\"RBAC (main docs)\",\"url\":\"/docs/administration/rbac\",\"external\":\"$undefined\"},{\"$id\":\"self-hosting:_5\",\"type\":\"page\",\"icon\":\"$undefined\",\"name\":\"Data Retention (main docs)\",\"url\":\"/docs/administration/data-retention\",\"external\":\"$undefined\"}],\"$id\":\"self-hosting:security\",\"$ref\":{\"folder\":\"security\",\"meta\":\"security/meta.json\"},\"icon\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"Administration\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"self-hosting:administration/index.mdx\",\"type\":\"page\",\"name\":\"Overview\",\"description\":\"Comprehensive overview of administration capabilities for self-hosted Langfuse deployments.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/administration\",\"$ref\":\"administration/index.mdx\"},{\"$id\":\"self-hosting:administration/automated-access-provisioning.mdx\",\"type\":\"page\",\"name\":\"Automated Access Provisioning\",\"description\":\"Optionally, you can configure automated access provisioning for new users when self-hosting Langfuse.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/administration/automated-access-provisioning\",\"$ref\":\"administration/automated-access-provisioning.mdx\"},{\"$id\":\"self-hosting:administration/headless-initialization.mdx\",\"type\":\"page\",\"name\":\"Headless Initialization\",\"description\":\"Learn how to automatically initialize Langfuse resources via environment variables.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/administration/headless-initialization\",\"$ref\":\"administration/headless-initialization.mdx\"},{\"$id\":\"self-hosting:administration/organization-creators.mdx\",\"type\":\"page\",\"name\":\"Organization Creators (EE)\",\"description\":\"Learn how to restrict organization creation to a specific set of users in your self-hosted Langfuse deployment.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/administration/organization-creators\",\"$ref\":\"administration/organization-creators.mdx\"},{\"$id\":\"self-hosting:administration/ui-customization.mdx\",\"type\":\"page\",\"name\":\"UI Customization (EE)\",\"description\":\"Learn how to customize the Langfuse UI for your organization.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/administration/ui-customization\",\"$ref\":\"administration/ui-customization.mdx\"},{\"$id\":\"self-hosting:administration/instance-management-api.mdx\",\"type\":\"page\",\"name\":\"Management API (EE)\",\"description\":\"Learn how to create, update, and delete organizations via the Langfuse API on self-hosted installations.\",\"icon\":\"$undefined\",\"url\":\"/self-hosting/administration/instance-management-api\",\"$ref\":\"administration/instance-management-api.mdx\"}],\"$id\":\"self-hosting:administration\",\"$ref\":{\"folder\":\"administration\",\"meta\":\"administration/meta.json\"},\"icon\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"Upgrade\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"self-hosting:upgrade/index.mdx\",