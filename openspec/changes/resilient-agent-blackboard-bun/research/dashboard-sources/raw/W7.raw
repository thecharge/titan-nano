 Check</h3><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-4 shrink-0 text-text-secondary" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></div><div class="prose-no-margin text-sm text-text-primary empty:hidden"></div></div></div></a><a data-card="true" class="block @max-lg:col-span-full" href="/self-hosting/configuration/observability"><div class="relative bg-surface-bg border border-line-structure corner-box-corners group/box corner-box-hover-stripes transition-[background] duration-180 ease-out flex h-full w-full flex-row items-center gap-2.5 p-2 text-text-primary sm:p-3"><div class="not-prose shrink-0 [&amp;_svg]:size-5 [&amp;_img]:size-5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></div><div class="flex min-w-0 flex-1 flex-col gap-1"><div class="flex items-center gap-1"><h3 class="font-sans text-[14px] not-italic leading-[150%] lg:leading-[120%] tracking-[-0.26px] [font-variant-numeric:ordinal] not-prose mb-0 min-w-0 flex-1 font-medium text-left text-text-secondary">Observability via OpenTelemetry</h3><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-4 shrink-0 text-text-secondary" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></div><div class="prose-no-margin text-sm text-text-primary empty:hidden"></div></div></div></a><a data-card="true" class="block @max-lg:col-span-full" href="/self-hosting/configuration/transactional-emails"><div class="relative bg-surface-bg border border-line-structure corner-box-corners group/box corner-box-hover-stripes transition-[background] duration-180 ease-out flex h-full w-full flex-row items-center gap-2.5 p-2 text-text-primary sm:p-3"><div class="not-prose shrink-0 [&amp;_svg]:size-5 [&amp;_img]:size-5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg></div><div class="flex min-w-0 flex-1 flex-col gap-1"><div class="flex items-center gap-1"><h3 class="font-sans text-[14px] not-italic leading-[150%] lg:leading-[120%] tracking-[-0.26px] [font-variant-numeric:ordinal] not-prose mb-0 min-w-0 flex-1 font-medium text-left text-text-secondary">Transactional Emails</h3><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-4 shrink-0 text-text-secondary" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></div><div class="prose-no-margin text-sm text-text-primary empty:hidden"></div></div></div></a><a data-card="true" class="block @max-lg:col-span-full" href="/self-hosting/administration/ui-customization"><div class="relative bg-surface-bg border border-line-structure corner-box-corners group/box corner-box-hover-stripes transition-[background] duration-180 ease-out flex h-full w-full flex-row items-center gap-2.5 p-2 text-text-primary sm:p-3"><div class="not-prose shrink-0 [&amp;_svg]:size-5 [&amp;_img]:size-5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="