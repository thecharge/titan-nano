ned\",\"className\":\"font-sans font-[430] not-italic tracking-[-0.26px] [font-variant-numeric:ordinal] text-[13px] leading-[150%] lg:leading-[150%] text-left text-inherit transition-[color]\",\"children\":\"Support\"}]}]}],\"$Lbd\"]}]]}]]}]\na3:[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/gcp\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"GCP\"}]\na4:[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/render\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Render\"}]\na5:[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/railway\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Railway\"}]\na6:[\"$\",\"td\",null,{\"children\":\"Your infrastructure\"}]\na7:[\"$\",\"p\",null,{\"children\":[\"Unless marked as community-supported, these deployment options are maintained and tested by the Langfuse team. Community-supported options are maintained in third-party repositories and supported on a best-effort basis. Report problems via \",[\"$\",\"$L4c\",null,{\"href\":\"/issues\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"GitHub issues\"}],\".\"]}]\na8:[\"$\",\"$La2\",null,{\"as\":\"h2\",\"id\":\"architecture\",\"children\":\"Architecture\"}]\na9:[\"$\",\"p\",null,{\"children\":\"Langfuse only depends on open source components and can be deployed locally, on cloud infrastructure, or on-premises.\"}]\naa:[\"$\",\"figure\",null,{\"className\":\"not-prose _0iyPUa_figure\",\"aria-label\":\"Langfuse self-hosting architecture\",\"children\":[[\"$\",\"div\",null,{\"className\":\"_0iyPUa_header\",\"children\":[\"$\",\"span\",null,{\"className\":\"_0iyPUa_eyebrow\",\"children\":\"Deployment architecture\"}]}],[\"$\",\"div\",null,{\"className\":\"_0iyPUa_desktop\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"-8 0 808 760\",\"className\":\"_0iyPUa_diagram\",\"role\":\"group\",\"aria-label\":\"Web and worker containers connected to four shared storage services, with an optional AI gateway\",\"children\":[[\"$\",\"desc\",null,{\"children\":\"UI, API, and SDK clients connect to Langfuse Web. Web connects to PostgreSQL, Redis or Valkey, ClickHouse, and S3 or blob storage. Redis queues jobs for Langfuse Worker, which connects to PostgreSQL, ClickHouse, and S3. Both containers can optionally connect to LLM providers: Web for the playground, Worker for evaluations. The optional Langfuse AI gateway receives model requests from applications and coding agents, resolves gateway keys and uploads traces through Langfuse Web, and relays the requests to the LLM providers. The application containers, gateway, and storage run in your VPC or on-premises. The LLM providers can also run in the same VPC or a peered VPC.\"}],[\"$\",\"rect\",null,{\"x\":\"20\",\"y\":\"104\",\"width\":\"760\",\"height\":\"528\",\"rx\":\"12\",\"className\":\"_0iyPUa_boundary\"}],[\"$\",\"text\",null,{\"x\":\"760\",\"y\":\"136\",\"textAnchor\":\"end\",\"className\":\"_0iyPUa_detail\",\"children\":\"VPC / on-premises\"}],[\"$\",\"g\",null,{\"transform\":\"translate(40 24)\",\"children\":[[\"$\",\"rect\",null,{\"width\":\"200\",\"height\":\"54\",\"rx\":\"8\",\"className\":\"_0iyPUa_card\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-globe _0iyPUa_icon\",\"x\":16,\"y\":17,\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"13o1zl\",{\"d\":\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"}],[\"$\",\"path\",\"9i4pu4\",{\"d\":\"M2 12h20\"}],\"$undefined\"]}],[\"$\",\"text\",null,{\"x\":\"46\",\"y\":\"33\",\"className\":\"_0iyPUa_name\",\"children\":\"UI, API \u0026 SDKs\"}]]}],[\"$\",\"g\",null,{\"transform\":\"translate(300 24)\",\"children\":[[\"$\",\"rect\",null,{\"width\":\"200\",\"height\":\"54\",\"rx\":\"8\",\"className\":\"_0iyPUa_card\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-bot _0iyPUa_icon\",\"x\":16,\"y\":17,\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"hb8ula\",{\"d\":\"M12 8V4H8\"}],[\"$\",\"rect\",\"enze0r\",{\"width\":\"16\",\"height\":\"12\",\"x\":\"4\",\"y\":\"8\",\"rx\":\"2\"}],[\"$\",\"path\",\"vft8re\",{\"d\":\"M2 14h2\"}],[\"$\",\"path\",\"4cs60a\",{\"d\":\"M20 14h2\"}],[\"$\",\"path\",\"1xurst\",{\"d\":\"M15 13v2\"}],[\"$\",\"path\",\"rq6x2g\",{\"d\":\"M9 13v2\"}],\"$undefined\"]}],[\"$\",\"text\",null,{\"x\":\"46\",\"y\":\"33\",\"className\":\"_0iyPUa_name\",\"children\":\"Apps \u0026 agents\"}]]}],[\"$\",\"g\",null,{\"className\":\"_0iyPUa_optionalPaths\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M 400 78 V 140 H 140 V 168\"}],[\"$\",\"path\",null,{\"d\":\"M 140 294 V 334\"}],[\"$\",\"path\",null,{\"d\":\"M 40 231 H 24 V 692 H 280\"}],[\"$\",\"path\",null,{\"d\":\"M 140 460 V 636 Q 140 656 156 656 H 280\"}],[\"$\",\"path\",null,{\"d\":\"M 660 460 V 636 Q 660 656 644 656 H 520\"}]]}],[\"$\",\"g\",null,{\"className\":\"_0iyPUa_webPaths\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M 40 51 H 8 V 397 H 40\"}],[\"$\",\"path\",null,{\"d\":\"M 240 348 C 270 348 270 208 300 208\"}],[\"$\",\"path\",null,{\"d\":\"M 240 372 C 270 372 270 312 300 312\"}],[\"$\",\"path\",null,{\"d\":\"M 240 396 C 270 396 270 416 300 416\"}],[\"$\",\"path\",null,{\"d\":\"M 240 420 C 270 420 270 520 300 520\"}],[[\"$\",\"path\",\"postgres\",{\"d\":\"m 294 204 6 4 -6 4\"}],[\"$\",\"path\",\"cache\",{\"d\":\"m 294 308 6 4 -6 4\"}],[\"$\",\"path\",\"clickhouse\",{\"d\":\"m 294 412 6 4 -6 4\"}],[\"$\",\"path\",\"blobstorage\",{\"d\":\"m 294 516 6 4 -6 4\"}]]]}],[\"$\",\"g\",null,{\"className\":\"_0iyPUa_workerPaths\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M 560 348 C 530 348 530 208 500 208\"}],[\"$\",\"path\",null,{\"d\":\"M 500 312 C 530 312 530 372 560 372\"}],[\"$\",\"path\",null,{\"d\":\"m 554 368 6 4 -6 4\"}],[\"$\",\"path\",null,{\"d\":\"M 560 396 C 530 396 530 416 500 416\"}],[\"$\",\"path\",null,{\"d\":\"M 560 420 C 530 420 530 520 500 520\"}],[[\"$\",\"path\",\"postgres\",{\"d\":\"m 506 204 -6 4 6 4\"}],[\"$\",\"path\",\"clickhouse\",{\"d\":\"m 506 412 -6 4 6 4\"}],[\"$\",\"path\",\"blobstorage\",{\"d\":\"m 506 516 -6 4 6 4\"}]]]}],\"$Lbe\",\"$Lbf\",\"$Lc0\",\"$Lc1\",\"$Lc2\",\"$Lc3\",\"$Lc4\",\"$Lc5\",\"$Lc6\",\"$Lc7\",[\"$Lc8\",\"$Lc9\",\"$Lca\",\"$Lcb\"],\"$Lcc\"]}]}],\"$Lcd\",\"$Lce\"]}]\nab:[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"children\":\"View architecture components\"}],[[\"$\",\"p\",null,{\"children\":\"Langfuse consists of two application containers, storage components, and an optional LLM API/Gateway.\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/infrastructure/containers\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":[\"$\",\"strong\",null,{\"children\":\"Application Containers\"}]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Langfuse Web: The main web application serving the Langfuse UI and APIs.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Langfuse Worker: A worker that asynchronously processes events.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/configuration/ai-gateway\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Langfuse AI Gateway\"}],\" (optional, beta): Relays model requests from applications and coding agents to LLM providers and records them in Langfuse.\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Storage Components\"}],\":\",\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/infrastructure/postgres\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Postgres\"}],\": The main database for transactional workloads.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/infrastructure/clickhouse\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Clickhouse\"}],\": High-performance OLAP database which stores traces, observations, and scores.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/infrastructure/cache\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Redis/Valkey cache\"}],\": A fast in-memory data structure store. Used for queue and cache operations.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/infrastructure/blobstorage\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"S3/Blob Store\"}],\": Object storage to persist all incoming events, multi-modal inputs, and large exports.\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/deployment/infrastructure/llm-api\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"$Lcf\"}],\": Some features depend on an external LLM API or gateway.\"]}],\"\\n\"]}],\"\\n\",\"$Ld0\"]]}]\nf0:I[859468,[\"$2\",\"$3\",\"$4\",\"$5\",\"$6\",\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$c\",\"$d\",\"$e\",\"$12\",\"$13\",\"$14\",\"$15\",\"$16\",\"$17\",\"$18\",\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$1d\",\"$1e\",\"$1f\",\"$20\",\"$21\",\"$22\",\"$23\",\"$24\"],\"Video\"]\nf1:I[125896,[\"$2\",\"$3\",\"$4\",\"$5\",\"$6\",\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$c\",\"$d\",\"$e\",\"$12\",\"$13\",\"$14\",\"$15\",\"$16\",\"$17\",\"$18\",\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$1d\",\"$1e\",\"$1f\",\"$20\",\"$21\",\"$22\",\"$23\",\"$24\"],\"LinkBox\"]\nf6:I[114828,[\"$2\",\"$3\",\"$4\",\"$5\",\"$6\",\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$c\",\"$d\",\"$e\"],\"IconMark\"]\nac:[\"$\",\"$La2\",null,{\"as\":\"h2\",\"id\":\"optimized-for-performance-reliability-and-uptime\",\"children\":\"Optimized for performance, reliability, and uptime\"}]\nad:[\"$\",\"p\",null,{\"children\":[\"Langfuse OSS and Enterprise use the same codebase as Langfuse Cloud. Langfuse processes\",\" \",[\"$\",\"strong\",null,{\"children\":[\"90B+\",\" observations per month\"]}],\" and is trusted by \",[\"$\",\"strong\",null,{\"children\":[21,\" of the Fortune 50\"]}],\". Its Docker images have been pulled\",\" \",[\"$\",\"strong\",null,{\"children\":[\"38M+\",\" times\"]}],\".\"]}]\nae:[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"children\":\"How Langfuse is optimized for scale and reliability\"}],[\"$\",\"p\",null,{\"children\":\"Some of the optimizations include:\"}],[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Queued trace ingestion\"}],\": All traces are received in batches by the Langfuse Web container and immediately written to S3. Only a reference is persisted in Redis for queueing. Afterwards, the Langfuse Worker will pick up the traces from S3 and ingest them into Clickhouse. This ensures that high spikes in request load do not lead to timeouts or errors constrained by the database.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Caching of API keys\"}],\": API keys are cached in-memory in Redis. Thereby, the database is not hit on every API call and unauthorized requests can be rejected with very low resource usage.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Caching of prompts (SDKs and API)\"}],\": Even though prompts are cached client-side by the Langfuse SDKs and only revalidated in the background (\",[\"$\",\"$L4c\",null,{\"href\":\"/docs/prompts\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"docs\"}],\"), they need to be fetched from the Langfuse on first use. Thus, API response times are very important. Prompts are cached in a read-through cache in Redis. Thereby, hot prompts can be fetched from Langfuse without hitting a database.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Hyper-optimized ClickHouse schema\"}],\": Read-heavy analytical operations use a wide, mostly immutable observations table that avoids read-time joins and deduplication while taking advantage of ClickHouse's most performant access patterns. Read how we \",[\"$\",\"$L4c\",null,{\"href\":\"/blog/2026-03-10-simplify-langfuse-for-scale\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"simplified Langfuse for scale\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Multi-modal traces in S3\"}],\": Multi-modal traces can include large videos or arbitrary files. To enable support for these, they are directly uploaded to S3/Blob Storage from the client SDKs. Learn more about \",[\"$\",\"$L4c\",null,{\"href\":\"/docs/tracing-features/multi-modality\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"multi-modal traces\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Recoverability of events\"}],\": All incoming tracing and evaluation events are persisted in S3/Blob Storage first. Only after successful processing, the events are written to the database. This ensures that even if the database is temporarily unavailable, the events are not lost and can be processed later.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Background migrations\"}],\": Long-running migrations that are required by an upgrade but not blocking for regular operations are offloaded to a background job. This massively reduces the downtime during an upgrade. Learn more about \",\"$Ld1\",\".\"]}],\"\\n\"]}]]}]\n"])</script><script>self.__next_f.push([1,"af:[\"$\",\"$La2\",null,{\"as\":\"h2\",\"id\":\"features\",\"children\":\"Features\"}]\nb0:[\"$\",\"p\",null,{\"children\":[\"Langfuse supports many configuration options and self-hosted features.\\nFor more details, please refer to the \",[\"$\",\"$L4c\",null,{\"href\":\"/self-hosting/configuration\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"configuration guide\"}],\".\"]}]\nb1:[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-3 @container sm:grid-cols-3\",\"children\":[[\"$\",\"$Ld2\",null,{\"href\":\"/self-hosting/configuration/ai-gateway\",\"data-card\":true,\"className\":\"block @max-lg:col-span-full\",\"children\":[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"relative bg-surface-bg border border-line-structure corner-box-corners group/box corner-box-hover-stripes transition-[background] duration-180 ease-out flex h-full w-full flex-row items-center gap-2.5 p-2 text-text-primary sm:p-3\",\"style\":\"$undefined\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"not-prose shrink-0 [\u0026_svg]:size-5 [\u0026_img]:size-5\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"24\",\"height\":\"24\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-waypoints\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"4mc350\",{\"d\":\"m10.586 5.414-5.172 5.172\"}],[\"$\",\"path\",\"8c96vv\",{\"d\":\"m18.586 13.414-5.172 5.172\"}],[\"$\",\"path\",\"8npq4p\",{\"d\":\"M6 12h12\"}],[\"$\",\"circle\",\"144qzu\",{\"cx\":\"12\",\"cy\":\"20\",\"r\":\"2\"}],[\"$\",\"circle\",\"muu5ef\",{\"cx\":\"12\",\"cy\