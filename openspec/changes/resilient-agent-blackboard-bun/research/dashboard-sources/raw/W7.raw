3.9A1 1 0 0 0 22 17"></path></svg><span class="_0iyPUa_mobileCopy"><span class="_0iyPUa_mobileName">ClickHouse</span><span class="_0iyPUa_mobileDetail">Observability data</span></span></a><a href="/self-hosting/deployment/infrastructure/blobstorage" class="_0iyPUa_mobileCard " aria-label="S3 / Blob storage: Events &amp; attachments. View documentation."><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hard-drive _0iyPUa_mobileIcon" aria-hidden="true"><path d="M10 16h.01"></path><path d="M2.212 11.577a2 2 0 0 0-.212.896V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5.527a2 2 0 0 0-.212-.896L18.55 5.11A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path><path d="M21.946 12.013H2.054"></path><path d="M6 16h.01"></path></svg><span class="_0iyPUa_mobileCopy"><span class="_0iyPUa_mobileName">S3 / Blob storage</span><span class="_0iyPUa_mobileDetail">Events &amp; attachments</span></span></a></div><div class="_0iyPUa_mobileConnector _0iyPUa_workerConnector"><span class="_0iyPUa_mobileRail" aria-hidden="true"></span><span>Background processing</span></div><a href="/self-hosting/deployment/infrastructure/containers" class="_0iyPUa_mobileCard _0iyPUa_worker" aria-label="Langfuse Worker: Async event processing. View documentation."><span class="_0iyPUa_mobileAccent" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-blocks _0iyPUa_mobileIcon" aria-hidden="true"><path d="M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2"></path><rect x="14" y="2" width="8" height="8" rx="1"></rect></svg><span class="_0iyPUa_mobileCopy"><span class="_0iyPUa_mobileName">Langfuse Worker</span><span class="_0iyPUa_mobileDetail">Async event processing</span><span class="_0iyPUa_mobileImage">langfuse/worker</span></span></a></div><div class="_0iyPUa_mobileConnector _0iyPUa_optionalConnector"><span class="_0iyPUa_mobileRail" aria-hidden="true"></span><span>Playground · evaluations</span></div><a href="/self-hosting/deployment/infrastructure/llm-api" class="_0iyPUa_mobileCard " aria-label="LLM providers: Optional · bring your own. View documentation."><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles _0iyPUa_mobileIcon" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg><span class="_0iyPUa_mobileCopy"><span class="_0iyPUa_mobileName">LLM providers</span><span class="_0iyPUa_mobileDetail">Optional · bring your own</span></span></a></div><figcaption class="_0iyPUa_caption"><div class="_0iyPUa_legend"><span><i class="_0iyPUa_webKey"></i>Web connections</span><span><i class="_0iyPUa_workerKey"></i>Worker connections</span><span><i class="_0iyPUa_optionalKey"></i>Optional</span></div><p>The optional AI gateway relays model requests from your apps and coding agents to your LLM providers and records them in Langfuse. LLM providers can also run in the same VPC or a peered VPC.</p></figcaption></figure>
<!-- -->
<details><summary>View architecture components</summary><p>Langfuse consists of two application containers, storage components, and an optional LLM API/Gateway.</p>
<ul>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/deployment/infrastructure/containers"><strong>Application Containers</strong></a>
<ul>
<li>Langfuse Web: The main web application serving the Langfuse UI and APIs.</li>
<li>Langfuse Worker: A worker that asynchronously processes events.</li>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/configuration/ai-gateway">Langfuse AI Gateway</a> (optional, beta): Relays model requests from applications and coding agents to LLM providers and records them in Langfuse.</li>
</ul>
</li>
<li><strong>Storage Components</strong>:<!-- -->
<ul>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/deployment/infrastructure/postgres">Postgres</a>: The main database for transactional workloads.</li>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/deployment/infrastructure/clickhouse">Clickhouse</a>: High-performance OLAP database which stores traces, observations, and scores.</li>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/deployment/infrastructure/cache">Redis/Valkey cache</a>: A fast in-memory data structure store. Used for queue and cache operations.</li>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/deployment/infrastructure/blobstorage">S3/Blob Store</a>: Object storage to persist all incoming events, multi-modal inputs, and large exports.</li>
</ul>
</li>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/deployment/infrastructure/llm-api"><strong>LLM API / Gateway</strong></a>: Some features depend on an external LLM API or gateway.</li>
</ul>
<p>Langfuse can be deployed within a VPC or on-premises in high-security environments.
Internet access is optional.
See <a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/security/networking">networking</a> documentation for more details.</p></details>
<h2 id="optimized-for-performance-reliability-and-uptime" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#optimized-for-performance-reliability-and-uptime">Optimized for performance, reliability, and uptime</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h2>
<!-- -->
<p>Langfuse OSS and Enterprise use the same codebase as Langfuse Cloud. Langfuse processes<!-- --> <strong>90B+<!-- --> observations per month</strong> and is trusted by <strong>21<!-- --> of the Fortune 50</strong>. Its Docker images have been pulled<!-- --> <strong>38M+<!-- --> times</strong>.</p>
<details><summary>How Langfuse is optimized for scale and reliability</summary><p>Some of the optimizations include:</p><ul>
<li><strong>Queued trace ingestion</strong>: All traces are received in batches by the Langfuse Web container and immediately written to S3. Only a reference is persisted in Redis for queueing. Afterwards, the Langfuse Worker will pick up the traces from S3 and ingest them into Clickhouse. This ensures that high spikes in request load do not lead to timeouts or errors constrained by the database.</li>
<li><strong>Caching of API keys</strong>: API keys are cached in-memory in Redis. Thereby, the database is not hit on every API call and unauthorized requests can be rejected with very low resource usage.</li>
<li><strong>Caching of prompts (SDKs and API)</strong>: Even though prompts are cached client-side by the Langfuse SDKs and only revalidated in the background (<a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/docs/prompts">docs</a>), they need to be fetched from the Langfuse on first use. Thus, API response times are very important. Prompts are cached in a read-through cache in Redis. Thereby, hot prompts can be fetched from Langfuse without hitting a database.</li>
<li><strong>Hyper-optimized ClickHouse schema</strong>: Read-heavy analytical operations use a wide, mostly immutable observations table that avoids read-time joins and deduplication while taking advantage of ClickHouse&#x27;s most performant access patterns. Read how we <a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/blog/2026-03-10-simplify-langfuse-for-scale">simplified Langfuse for scale</a>.</li>
<li><strong>Multi-modal traces in S3</strong>: Multi-modal traces can include large videos or arbitrary files. To enable support for these, they are directly uploaded to S3/Blob Storage from the client SDKs. Learn more about <a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/docs/tracing-features/multi-modality">multi-modal traces</a>.</li>
<li><strong>Recoverability of events</strong>: All incoming tracing and evaluation events are persisted in S3/Blob Storage first. Only after successful processing, the events are written to the database. This ensures that even if the database is temporarily unavailable, the events are not lost and can be processed later.</li>
<li><strong>Background migrations</strong>: Long-running migrations that are required by an upgrade but not blocking for regular operations are offloaded to a background job. This massively reduces the downtime during an upgrade. Learn more about <a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/upgrade/background-migrations">background migrations</a>.</li>
</ul></details>
<h2 id="features" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#features">Features</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h2>
<p>Langfuse supports many configuration options and self-hosted features.
For more details, please refer to the <a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/configuration">configuration guide</a>.</p>
