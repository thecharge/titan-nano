<span class="line"></span>
<span class="line"><span class="s-6272a4"># Run production server</span></span>
<span class="line"><span class="s-f8f8f2">NODE_ENV=production bun dist/index.js</span></span></code></pre></div></div><button type="button" aria-label="Copy to clipboard" class="CopyIcon group/copy inline-flex items-center justify-center rounded-md text-fg-faint transition-[color,background,opacity] hover:bg-fg/[0.06] hover:text-fg h-7 w-7 copy absolute right-1.5 top-[-3px]"><span class="relative block h-4 w-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 transition-[opacity,transform] duration-200 opacity-100"><path d="M5.5 16H3V3h13v2.5"></path><path d="M8 8h9l4 4v9H8z"></path></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 text-success transition-[opacity,transform] duration-200 scale-75 opacity-0"><path d="M4 12l5 5L20 6"></path></svg></span></button></div></div></div></div><h3 id="docker-deployment" class="anchored">Docker Deployment<a href="#docker-deployment" aria-label="Permalink" data-pagefind-ignore="" class="anchor">#</a></h3><div class="DocFence group/fence relative my-5 overflow-hidden rounded-lg border border-line bg-code-bg text-code-fg [&amp;:has(+.DocFence-output)]:rounded-b-none" data-lang="dockerfile"><div class="DocFenceHeader flex min-h-[34px] items-center gap-2 border-b border-line bg-subtle/70 px-3.5 py-1.5 font-mono text-[12px] leading-none text-fg-muted"><span class="doc-icon inline-flex shrink-0 [&amp;&gt;svg]:h-full [&amp;&gt;svg]:w-full h-4 w-4 shrink-0" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M3 7.5l9 4.5 9-4.5L12 3z" fill="currentColor" opacity="0.3" stroke="none"/><path d="M12 3l9 4.5v9L12 21l-9-4.5v-9z"/><path d="M4 8l8 4 8-4M12 12v8.5"/><path d="M6.5 12v4M9.5 13.5v4M14.5 13.5v4M17.5 12v4"/></svg></span><span class="truncate" translate="no">Dockerfile</span></div><div class="relative"><div class="CodeBlock group/code !my-0 !rounded-none !border-0 [&amp;_pre]:!overflow-x-visible [&amp;_.line-hl]:inline-block [&amp;_.line-hl]:min-w-[calc(100%+4.1rem)] [&amp;_.line-hl]:-ml-[1.1rem] [&amp;_.line-hl]:pl-[calc(1.1rem-3px)] [&amp;_.line-hl]:pr-12 [&amp;_.line-hl]:align-top [&amp;_.line-hl]:h-5 [&amp;_.line-hl]:border-l-[3px] [&amp;_.line-hl]:border-accent [&amp;_.line-hl]:bg-accent/[0.09]"><div class="relative"><div class="CodeBlockScroll"><div data-h="38"><pre class="shiki"><code><span class="line"><span class="s-f8f8f2">FROM oven/bun:1 as base</span></span>
<span class="line"><span class="s-f8f8f2">WORKDIR /usr/src/app</span></span>
<span class="line"><span class="s-f8f8f2"></span></span>
<span class="line"><span class="s-f8f8f2"># Install dependencies</span></span>
<span class="line"><span class="s-f8f8f2">COPY package.json bun.lock ./</span></span>
<span class="line"><span class="s-f8f8f2">RUN bun install --frozen-lockfile</span></span>
<span class="line"><span class="s-f8f8f2"></span></span>
<span class="line"><span class="s-f8f8f2"># Copy source code</span></span>
<span class="line"><span class="s-f8f8f2">COPY . .</span></span>
<span class="line"><span class="s-f8f8f2"></span></span>
<span class="line"><span class="s-f8f8f2"># Build application</span></span>
<span class="line"><span class="s-f8f8f2">RUN bun build --target=bun --production --outdir=dist ./server/index.ts</span></span>
<span class="line"><span class="s-f8f8f2"></span></span>
<span class="line"><span class="s-f8f8f2"># Production stage</span></span>
<span class="line"><span class="s-f8f8f2">FROM oven/bun:1-slim</span></span>
<span class="line"><span class="s-f8f8f2">WORKDIR /usr/src/app</span></span>
<span class="line"><span class="s-f8f8f2">COPY --from=base /usr/src/app/dist ./</span></span>
<span class="line"><span class="s-f8f8f2">COPY --from=base /usr/src/app/public ./public</span></span>
<span class="line"><span class="s-f8f8f2"></span></span>
<span class="line"><span class="s-f8f8f2">EXPOSE 3000</span></span>
<span class="line"><span class="s-f8f8f2">CMD [&quot;bun&quot;, &quot;index.js&quot;]</span></span></code></pre></div></div><button type="button" aria-label="Copy to clipboard" class="CopyIcon group/copy inline-flex items-center justify-center rounded-md text-fg-faint transition-[color,background,opacity] hover:bg-fg/[0.06] hover:text-fg h-7 w-7 copy absolute right-1.5 top-[-3px]"><span class="relative block h-4 w-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 transition-[opacity,transform] duration-200 opacity-100"><path d="M5.5 16H3V3h13v2.5"></path><path d="M8 8h9l4 4v9H8z"></path></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 text-success transition-[opacity,transform] duration-200 scale-75 opacity-0"><path d="M4 12l5 5L20 6"></path></svg></span></button></div></div></div></div><h3 id="environment-variables" class="anchored">Environment Variables<a href="#environment-variables" aria-label="Permalink" data-pagefind-ignore="" class="anchor">#</a></h3><div class="DocFence group/fence relative my-5 overflow-hidden rounded-lg border border-line bg-code-bg text-code-fg [&amp;:has(+.DocFence-output)]:rounded-b-none" data-lang="ini"><div class="DocFenceHeader flex min-h-[34px] items-center gap-2 border-b border-line bg-subtle/70 px-3.5 py-1.5 font-mono text-[12px] leading-none text-fg-muted"><span class="doc-icon inline-flex shrink-0 [&amp;&gt;svg]:h-full [&amp;&gt;svg]:w-full h-4 w-4 shrink-0" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M3 3h14l4 4v14H3z"/><path d="M10 11l-3 3 3 3"/><path d="M14 11l3 3-3 3"/></svg></span><span class="truncate" translate="no">.env.production</span></div><div class="relative"><div class="CodeBlock group/code !my-0 !rounded-none !border-0 [&amp;_pre]:!overflow-x-visible [&amp;_.line-hl]:inline-block [&amp;_.line-hl]:min-w-[calc(100%+4.1rem)] [&amp;_.line-hl]:-ml-[1.1rem] [&amp;_.line-hl]:pl-[calc(1.1rem-3px)] [&amp;_.line-hl]:pr-12 [&amp;_.line-hl]:align-top [&amp;_.line-hl]:h-5 [&amp;_.line-hl]:border-l-[3px] [&amp;_.line-hl]:border-accent [&amp;_.line-hl]:bg-accent/[0.09]"><div class="relative"><div class="CodeBlockScroll"><div data-h="39"><pre class="shiki"><code><span class="line"><span class="s-ff79c6">NODE_ENV=</span><span class="s-f8f8f2">production</span></span>
<span class="line"><span class="s-ff79c6">PORT=</span><span class="s-f8f8f2">3000</span></span>
<span class="line"><span class="s-ff79c6">DATABASE_URL=</span><span class="s-f8f8f2">postgresql://user:pass@localhost:5432/myapp</span></span>
<span class="line"><span class="s-ff79c6">CORS_ORIGIN=</span><span class="s-f8f8f2">https://myapp.com</span></span></code></pre></div></div><button type="button" aria-label="Copy to clipboard" class="CopyIcon group/copy inline-flex items-center justify-center rounded-md text-fg-faint transition-[color,background,opacity] hover:bg-fg/[0.06] hover:text-fg h-7 w-7 copy absolute right-1.5 top-[-3px]"><span class="relative block h-4 w-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 transition-[opacity,transform] duration-200 opacity-100"><path d="M5.5 16H3V3h13v2.5"></path><path d="M8 8h9l4 4v9H8z"></path></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 text-success transition-[opacity,transform] duration-200 scale-75 opacity-0"><path d="M4 12l5 5L20 6"></path></svg></span></button></div></div></div></div><h2 id="migration-from-other-frameworks" class="anchored">Migration from Other Frameworks<a href="#migration-from-other-frameworks" aria-label="Permalink" data-pagefind-ignore="" class="anchor">#</a></h2><h3 id="from-express-webpack" class="anchored">From Express + Webpack<a href="#from-express-webpack" aria-label="Permalink" data-pagefind-ignore="" id="from-express--webpack" class="anchor">#</a></h3><div class="DocFence group/fence relative my-5 overflow-hidden rounded-lg border border-line bg-code-bg text-code-fg [&amp;:has(+.DocFence-output)]:rounded-b-none" data-lang="ts"><div class="DocFenceHeader flex min-h-[34px] items-center gap-2 border-b border-line bg-subtle/70 px-3.5 py-1.5 font-mono text-[12px] leading-none text-fg-muted"><span class="doc-icon inline-flex shrink-0 [&amp;&gt;svg]:h-full [&amp;&gt;svg]:w-full h-4 w-4 shrink-0" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M3 3h14l4 4v14H3z"/><path d="M6.5 10.5h5M9 10.5V18"/><path d="M18 10.5h-3l-1 1v2l1 1h2l1 1v1.5l-1 1h-3"/></svg></span><span class="truncate" translate="no">server.ts</span></div><div class="relative"><div class="CodeBlock group/code !my-0 !rounded-none !border-0 [&amp;_pre]:!overflow-x-visible [&amp;_.line-hl]:inline-block [&amp;_.line-hl]:min-w-[calc(100%+4.1rem)] [&amp;_.line-hl]:-ml-[1.1rem] [&amp;_.line-hl]:pl-[calc(1.1rem-3px)] [&amp;_.line-hl]:pr-12 [&amp;_.line-hl]:align-top [&amp;_.line-hl]:h-5 [&amp;_.line-hl]:border-l-[3px] [&amp;_.line-hl]:border-accent [&amp;_.line-hl]:bg-accent/[0.09]"><div class="relative"><div class="CodeBlockScroll"><div data-h="40"><pre class="shiki"><code><span class="line"><span class="s-6272a4">// Before (Express + Webpack)</span></span>
<span class="line"><span class="s-f8f8f2">app.</span><span class="s-50fa7b">use</span><span class="s-f8f8f2">(express.</span><span class="s-50fa7b">static</span><span class="s-f8f8f2">(</span><span class="s-e9f284">&quot;</span><span class="s-f1fa8c">dist</span><span class="s-e9f284">&quot;</span><span class="s-f8f8f2">));</span></span>
<span class="line"><span class="s-f8f8f2">app.</span><span class="s-50fa7b">get</span><span class="s-f8f8f2">(</span><span class="s-e9f284">&quot;</span><span class="s-f1fa8c">/api/users</span><span class="s-e9f284">&quot;</span><span class="s-f8f8f2">, (</span><span class="s-ffb86c s-i">req</span><span class="s-f8f8f2">, </span><span class="s-ffb86c s-i">res</span><span class="s-f8f8f2">) </span><span class="s-ff79c6">=&gt;</span><span class="s-f8f8f2"> {</span></span>
<span class="line"><span class="s-f8f8f2">  res.</span><span class="s-50fa7b">json</span><span class="s-f8f8f2">(users);</span></span>
<span class="line"><span class="s-f8f8f2">});</span></span>
<span class="line"></span>
<span class="line"><span class="s-6272a4">// After (Bun fullstack)</span></span>
<span class="line"><span class="s-50fa7b">serve</span><span class="s-f8f8f2">({</span></span>
<span class="line"><span class="s-f8f8f2">  routes</span><span class="s-ff79c6">:</span><span class="s-f8f8f2"> {</span></span>
<span class="line"><span class="s-f8f8f2">    </span><span class="s-e9f284">&quot;</span><span class="s-f1fa8c">/</span><span class="s-e9f284">&quot;</span><span class="s-ff79c6">:</span><span class="s-f8f8f2"> homepage, </span><span class="s-6272a4">// Replaces express.static</span></span>
<span class="line"><span class="s-f8f8f2">    </span><span class="s-e9f284">&quot;</span><span class="s-f1fa8c">/api/users</span><span class="s-e9f284">&quot;</span><span class="s-ff79c6">:</span><span class="s-f8f8f2"> {</span></span>
<span class="line"><span class="s-f8f8f2">      </span><span class="s-50fa7b">GET</span><span class="s-f8f8f2">() {</span></span>
<span class="line"><span class="s-f8f8f2">        </span><span class="s-ff79c6">return</span><span class="s-f8f8f2"> Response.</span><span class="s-50fa7b">json</span><span class="s-f8f8f2">(users);</span></span>
<span class="line"><span class="s-f8f8f2">      },</span></span>
<span class="line"><span class="s-f8f8f2">    },</span></span>
<span class="line"><span class="s-f8f8f2">  },</span></span>
<span class="line"><span class="s-f8f8f2">});</span></span></code></pre></div></div><button type="button" aria-label="Copy to clipboard" class="CopyIcon group/copy inline-flex items-center justify-center rounded-md text-fg-faint transition-[color,background,opacity] hover:bg-fg/[0.06] hover:text-fg h-7 w-7 copy absolute right-1.5 top-[-3px]"><span class="relative block h-4 w-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 transition-[opacity,transform] duration-200 opacity-100"><path d="M5.5 16H3V3h13v2.5"></path><path d="M8 8h9l4 4v9H8z"></path></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 text-success transition-[opacity,transform] duration-200 scale-75 opacity-0"><path d="M4 12l5 5L20 6"></path></svg></span></button></div></div></div></div><h3 id="from-next-js-api-routes" class="anchored">From Next.js API Routes<a href="#from-next-js-api-routes" aria-label="Permalink" data-pagefind-ignore="" id="from-nextjs-api-routes" class="anchor">#</a></h3><div class="DocFence group/fence relative my-5 overflow-hidden rounded-lg border border-line bg-code-bg text-code-fg [&amp;:has(+.DocFence-output)]:rounded-b-none" data-lang="ts"><div class="DocFenceHeader flex min-h-[34px] items-center gap-2 border-b border-line bg-subtle/70 px-3.5 py-1.5 font-mono text-[12px] leading-none text-fg-muted"><span class="doc-icon inline-flex shrink-0 [&amp;&gt;svg]:h-full [&amp;&gt;svg]:w-full h-4 w-4 shrink-0" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M3 3h14l4 4v14H3z"/><path d="M6.5 10.5h5M9 10.5V18"/><path d="M18 10.5h-3l-1 1v2l1 1h2l1 1v1.5l-1 1h-3"/></svg></span><span class="truncate" translate="no">server.ts</span></div><div class="relative"><div class="CodeBlock group/code !my-0 !rounded-none !border-0 [&amp;_pre]:!overflow-x-visible [&amp;_.line-hl]:inline-block [&amp;_.line-hl]:min-w-[calc(100%+4.1rem)] [&amp;_.line-hl]:-ml-[1.1rem] [&amp;_.line-hl]:pl-[calc(1.1rem-3px)] [&amp;_.line-hl]:pr-12 [&amp;_.line-hl]:align-top [&amp;_.line-hl]:h-5 [&amp;_.line-hl]:border-l-[3px] [&amp;_.line-hl]:border-accent [&amp;_.line-hl]:bg-accent/[0.09]"><div class="relative"><div class="CodeBlockScroll"><div data-h="41"><pre class="shiki"><code><span class="line"><span class="s-6272a4">// Before (Next.js)</span></span>
<span class="line"><span class="s-ff79c6">export</span><span class="s-f8f8f2"> </span><span class="s-ff79c6">default</span><span class="s-f8f8f2"> </span><span class="s-ff79c6">function</span><span class="s-f8f8f2"> </span><span class="s-50fa7b">handler</span><span class="s-f8f8f2">(</span><span class="s-ffb86c s-i">req</span><span class="s-f8f8f2">, </span><span class="s-ffb86c s-i">res</span><span class="s-f8f8f2">) {</span></span>
<span class="line"><span class="s-f8f8f2">  </span><span class="s-ff79c6">if</span><span class="s-f8f8f2"> (req.method </span><span class="s-ff79c6">===</span><span class="s-f8f8f2"> </span><span class="s-e9f284">&#39;</span><span class="s-f1fa8c">GET</span><span class="s-e9f284">&#39;</span><span class="s-f8f8f2">) {</span></span>
<span class="line"><span class="s-f8f8f2">    res.</span><span class="s-50fa7b">json</span><span class="s-f8f8f2">(users);</span></span>
<span class="line"><span class="s-f8f8f2">  }</span></span>
<span class="line"><span class="s-f8f8f2">}</span></span>
<span class="line"></span>
<span class="line"><span class="s-6272a4">// After (Bun)</span></span>
<span class="line"><span class="s-e9f284">&quot;</span><span class="s-f1fa8c">/api/users</span><span class="s-e9f284">&quot;</span><span class="s-f8f8f2">: {</span></span>
<span class="line"><span class="s-f8f8f2">  </span><span class="s-50fa7b">GET</span><span class="s-f8f8f2">() { </span><span class="s-ff79c6">return</span><span class="s-f8f8f2"> Response.</span><span class="s-50fa7b">json</span><span class="s-f8f8f2">(users); }</span></span>
<span class="line"><span class="s-f8f8f2">}</span></span></code></pre></div></div><button type="button" aria-label="Copy to clipboard" class="CopyIcon group/copy inline-flex items-center justify-center rounded-md text-fg-faint transition-[color,background,opacity] hover:bg-fg/[0.06] hover:text-fg h-7 w-7 copy absolute right-1.5 top-[-3px]"><span class="relative block h-4 w-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 transition-[opacity,transform] duration-200 opacity-100"><path d="M5.5 16H3V3h13v2.5"></path><path d="M8 8h9l4 4v9H8z"></path></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" class="absolute inset-0 h-4 w-4 text-success transition-[opacity,transform] duration-200 scale-75 opacity-0"><path d="M4 12l5 5L20 6"></path></svg></span></button></div></div></div></div><h2 id="limitations-and-future-plans" class="anchored">Limitations and Future Plans<a href="#limitations-and-future-plans" aria-label="Permalink" data-pagefind-ignore="" class="anchor">#</a></h2><h3 id="current-limitations" class="anchored">Current Limitations<a href="#current-limitations" aria-label="Permalink" data-pagefind-ignore="" class="anchor">#</a></h3><ul><li>Auto-discovery of API routes is not implemented</li><li>Server-side rendering (SSR) is not built-in</li></ul><h3 id="planned-features" class="anchored">Planned Features<a href="#planned-features" aria-label="Permalink" data-pagefind-ignore="" class="anchor">#</a></h3><ul><li>File-based routing for API endpoints</li><li>Built-in SSR support</li><li>Enhanced plugin ecosystem</li></ul><div data-callout="note" class="callout my-5 flex gap-3 overflow-hidden rounded-xl border px-4 py-3.5 text-[94%] leading-relaxed text-fg/90 border-info/30 bg-info/[0.06] [&amp;_.CodeBlock]:my-3 [&amp;_.DocFence]:my-3"><spa