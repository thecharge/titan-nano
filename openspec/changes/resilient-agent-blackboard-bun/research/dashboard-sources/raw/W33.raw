te" hreflang="x-default" href="https://aspire.dev/dashboard/configuration/"/><link rel="sitemap" href="/sitemap-index.xml"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><link rel="alternate" type="application/rss+xml" title="Aspire Docs RSS" href="/rss.xml"/><script type="text/plain" src="https://js.monitor.azure.com/scripts/c/ms.analytics-web-3.min.js" defer data-category="analytics"></script><script type="text/plain" src="/scripts/analytics/1ds.js" defer data-category="analytics"></script><script type="text/plain" src="/scripts/analytics/track.js" defer data-category="analytics"></script><link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml"/><link rel="shortcut icon" href="/favicon.ico"/><meta name="generator" content="Astro v7.4.1"/><meta name="generator" content="Starlight v0.41.3"/><meta property="og:title" content="Aspire dashboard configuration reference · Aspire"/><meta property="og:type" content="article"/><meta property="og:url" content="https://aspire.dev/dashboard/configuration/"/><meta property="og:locale" content="en"/><meta property="og:description" content="Configuration reference for the Aspire dashboard — OTLP endpoints, frontend authentication, resource service, telemetry limits, and standalone deployment options."/><meta name="description" content="Configuration reference for the Aspire dashboard — OTLP endpoints, frontend authentication, resource service, telemetry limits, and standalone deployment options."/><meta name="twitter:site" content="@aspiredotdev"/><meta name="keywords" content="Aspire, .NET Aspire, dotnet aspire, distributed applications, cloud-native, microservices, orchestration, .NET, observability, otel, opentelemetry, dashboard, service discovery, integrations, C#, csharp, multi-language, polyglot, python, go, node.js, javascript, typescript, vite, react, blazor, wasm, webassembly, aspnetcore, minimal apis, docker, containers, kubernetes, compose, AI, MCP, model context protocol, AI coding agents, agentic development, copilot, cursor, claude code, vibe coding"/><meta name="alternate-name" content=".NET Aspire"/><meta property="og:site_name" content="Aspire"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:domain" content="aspire.dev"/><meta name="apple-mobile-web-app-title" content="Aspire"/><link rel="preload" as="font" type="font/woff2" href="/_astro/poppins-latin-400-normal.cpxAROuN.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/_astro/poppins-latin-600-normal.zEkxB9Mr.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/_astro/poppins-latin-700-normal.Qrb0O0WB.woff2" crossorigin><script type="module" src="/_astro/Head.astro_astro_type_script_index_0_lang.DJSsXrzQ.js"></script><meta name="astro-view-transitions-enabled" content="true"><meta name="astro-view-transitions-fallback" content="swap"><script type="module" src="/_astro/ClientRouter.astro_astro_type_script_index_0_lang.DR1KA0y6.js"></script><meta property="og:image" content="https://aspire.dev/og/dashboard/configuration.png"><meta property="og:image:type" content="image/png"><meta property="og:image:alt" content="Aspire dashboard configuration reference"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:title" content="Aspire dashboard configuration reference · Aspire"><meta name="twitter:description" content="Configuration reference for the Aspire dashboard — OTLP endpoints, frontend authentication, resource service, telemetry limits, and standalone deployment options."><meta name="twitter:url" content="https://aspire.dev/dashboard/configuration/"><meta name="twitter:image" content="https://aspire.dev/og/dashboard/configuration.png"><meta name="twitter:image:alt" content="Aspire dashboard configuration reference"><script type="application/ld+json">{"@context":"https://schema.org","@type":"TechArticle","headline":"Aspire dashboard configuration reference","description":"Configuration reference for the Aspire dashboard — OTLP endpoints, frontend authentication, resource service, telemetry limits, and standalone deployment options.","author":{"@type":"Organization","name":"Aspire","url":"https://aspire.dev/"},"publisher":{"@type":"Organization","name":"Aspire","url":"https://aspire.dev/"},"url":"https://aspire.dev/dashboard/configuration/","inLanguage":"en","about":{"@type":"SoftwareApplication","name":"Aspire","alternateName":[".NET Aspire","Aspire.dev"],"description":"Aspire is the tool for code-first, extensible, observable dev and deploy.","applicationCategory":"DeveloperApplication","operatingSystem":"Windows, macOS, Linux","url":"https://aspire.dev/","isAccessibleForFree":true,"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}}}</script><!-- Restore persisted sidebar state before paint and keep legacy AppHost pages readable --><script>
  (function () {
    var appHostLangLabels = {
      csharp: 'C#',
      typescript: 'TypeScript',
    };
    var appHostLangStorageKey = 'starlight-synced-tabs__aspire-lang';

    function normalizeAppHostLang(value) {
      var normalized = (value || '').toLowerCase().replace(/\s+/g, '');
      if (normalized.indexOf('typescript') !== -1) {
        return 'typescript';
      }
      if (
        normalized.indexOf('c#') !== -1 ||
        normalized.indexOf('csharp') !== -1 ||
        normalized.indexOf('c-sharp') !== -1
      ) {
        return 'csharp';
      }
      return '';
    }

    function updateAppHostLangUrl(value) {
      var normalized = normalizeAppHostLang(value);
      if (!normalized) return;

      var url = new URL(window.location);
      url.searchParams.set('aspire-lang', normalized);
      window.history.replaceState(window.history.state, '', url);
    }

    function persistAppHostLang(value, root) {
      var normalized = normalizeAppHostLang(value);
      if (!normalized) return '';

      (root || document.documentElement).setAttribute('data-apphost-lang', normalized);
      try {
        localStorage.setItem('aspire-lang', normalized);
        localStorage.setItem(appHostLangStorageKey, appHostLangLabels[normalized]);
      } catch (e) {}
      return normalized;
    }

    function syncAppHostLangFromTab(value) {
      var normalized = persistAppHostLang(value);
      if (!normalized) return;
      updateAppHostLangUrl(normalized);
    }

    function initAppHostLangSync() {
      if (window.__aspireAppHostLangSyncInitialized) return;
      window.__aspireAppHostLangSyncInitialized = true;

      document.addEventListener('astro:before-swap', function (event) {
        restorePreferences(event.newDocument.documentElement, event.to);
      });

      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;

        var tab = target.closest('starlight-tabs[data-sync-key="aspire-lang"] [role="tab"]');
        if (tab) {
          var tabValue = normalizeAppHostLang(tab.textContent);
          if (tabValue) {
            window.requestAnimationFrame(function () {
              syncAppHostLangFromTab(tabValue);
            });
          }
        }
      });

      document.addEventListener('keydown', function (event) {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        var target = event.target;
        if (!(target instanceof Element)) return;
        var starlightTabs = target.closest('starlight-tabs[data-sync-key="aspire-lang"]');
        if (!starlightTabs) return;

        window.requestAnimationFrame(function () {
          var selectedTab = starlightTabs.querySelector('[role="tab"][aria-selected="true"]');
          var selectedValue = normalizeAppHostLang(selectedTab && selectedTab.textContent);
          if (selectedValue) {
            syncAppHostLangFromTab(selectedValue);
          }
        });
      });
    }

    function restorePreferences(root, url) {
      var qsAppHostLang = persistAppHostLang(url.searchParams.get('aspire-lang'), root);
      var rawAppHostLang = qsAppHostLang || 'typescript';

      try {
        rawAppHostLang =
          qsAppHostLang ||
          localStorage.getItem('aspire-lang') ||
          localStorage.getItem('aspire-apphost-lang') ||
          localStorage.getItem(appHostLangStorageKey) ||
          localStorage.getItem('starlight-synced-tabs__apphost-lang') ||
          localStorage.getItem('starlight-synced-tabs__apphost-implementation-lang') ||
          'typescript';
      } catch (e) {}

      persistAppHostLang(normalizeAppHostLang(rawAppHostLang) || 'typescript', root);

      try {
        var isApi = url.pathname.indexOf('/reference/api') !== -1;
        root.toggleAttribute(
          'data-sidebar-collapsed',
          isApi && localStorage.getItem('api-sidebar-collapsed') === '1'
        );
        root.toggleAttribute(
          'data-topic-sidebar-collapsed',
          !isApi && localStorage.getItem('topic-sidebar-collapsed') === '1'
        );
      } catch (e) {}
    }

    restorePreferences(document.documentElement, new URL(window.location.href));

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAppHostLangSync);
    } else {
      initAppHostLangSync();
    }
  })();
</script><!--
  WCP consent runtime. Per Microsoft WCP requirements this MUST be loaded live from
  the CDN and never bundled or self-hosted: the CDN applies geo-sensitive logic that
  decides whether the banner is shown and returns different payloads per region.
  `is:inline` stops Astro from processing/bundling it; `async` keeps a slow or blocked
  CDN from ever blocking page render.
--><script async src="https://wcpstatic.microsoft.com/mscc/lib/v2/wcp-consent.js"></script><script>
  (function () {
    if (window.__aspireWcpConsentInitialized) return;
    window.__aspireWcpConsentInitialized = true;

    // Cookie controls, including the Legal text action, are server-rendered. Once WCP
    // tells us whether consent is required for this region, reflect it on <html>
    // so CSS can hide those buttons where there is nothing to manage (e.g. the
    // US). Persist the answer so a returning visitor doesn't see the button
    // flash in before WCP loads.
    function setConsentRequirementState(isRequired) {
      try {
        var el = document.documentElement;
        if (el) {
          if (isRequired) {
            el.removeAttribute('data-consent-not-required');
          } else {
            el.setAttribute('data-consent-not-required', '');
          }
        }
        window.localStorage.setItem('aspireConsentRequired', isRequired ? 'true' : 'false');
      } catch (e) {}
    }

    // Before WCP loads, hide the buttons only if a previous visit already
    // established that consent is not required here. Unknown => leave them
    // visible; defaulting to visible keeps us failsafe (we never hide a control
    // a required region needs just because WCP was slow or blocked).
    function primeConsentRequirementState() {
      try {
        if (
          window.localStorage.getItem('aspireConsentRequired') === 'false' &&
          document.documentElement
        ) {
          document.documentElement.setAttribute('data-consent-not-required', '');
        }
      } catch (e) {}
    }

    primeConsentRequirementState();

    // Failsafe: if the CDN script is blocked (ad-blocker, firewall, CSP) or slow to
    // arrive, poll for a bounded window and then give up so the page never hangs or
    // spins forever. Consent code must never degrade the rest of the site.
    var MAX_INIT_ATTEMPTS = 150; // ~15s at 100ms intervals
    var initAttempts = 0;

    function toCulture(value) {
      var raw = (value || '').trim().replace('_', '-');
      if (!raw) return 'en-US';
      var parts = raw.split('-');
      var lang = (parts[0] || 'en').toLowerCase();
      var region = parts[1] ? parts[1].toUpperCase() : '';
      return region ? lang + '-' + region : lang;
    }

    function withSiteConsent(callback) {
      var siteConsent = window.__aspireWcpSiteConsent;
      if (!siteConsent) return false;
      try {
        callback(siteConsent);
      } catch (e) {}
      return true;
    }

    // WCP is a consent-collection API — unlike the previous cookie library it does
    // NOT manage <script> tags. The analytics scripts ship inert as
    // `type="text/plain" data-category="analytics"`; we must promote them to
    // executable ourselves once WCP reports Analytics consent (granted by default
    // where consent isn't required, e.g. the US). Without this bridge analytics
    // never loads anywhere.
    function activateAnalyticsScripts() {
      if (window.__aspireAnalyticsActivated) return;
      window.__aspireAnalyticsActivated = true;
      var pending = document.querySelectorAll(
        'script[type="text/plain"][data-category="analytics"]'
      );
      for (var i = 0; i < pending.length; i++) {
        var old = pending[i];
        var next = document.createElement('script');
        for (var a = 0; a < old.attributes.length; a++) {
          var attr = old.attributes[a];
          // Drop the neutralizing `type="text/plain"` so the browser executes it.
          if (attr.name === 'type') continue;
          next.setAttribute(attr.name, attr.value);
        }
        if (old.textContent) next.textContent = old.textContent;
        // The analytics scripts are order-dependent: the SDK must run before
        // 1ds.js (which reads `oneDS`) and track.js (which reads
        // `window.analytics`). Dynamically-created scripts default to async=true
        // and the copied `defer` is a no-op for them, so without this the two
        // tiny same-origin scripts win the race against the ~140 KB SDK and each
        // bail silently. Forcing async=false runs them in insertion (document)
        // order. Set after the copy so a stray `async` attribute can't override.
        next.async = false;
        if (old.parentNode) old.parentNode.replaceChild(next, old);
      }
    }

    function applyConsentToScripts(siteConsent) {
      try {
        var consent =
          typeof siteConsent.getConsent === 'function' ? siteConsent.getConsent() : null;
        if (consent && consent.Analytics) {
          activateAnalyticsScripts();
        }
      } catch (e) {}
    }

    function openManageConsent(event) {
      var target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('[data-cookie-manage-consent]')) return;
      var opened = false;
      withSiteConsent(function (siteConsent) {
        if (siteConsent.isConsentRequired) {
          siteConsent.manageConsent();
          opened = true;
        }
      });
      // Only suppress the trigger's native action when we actually opened WCP's
      // dialog. If WCP is blocked/slow (ad-blocker, CSP) or consent isn't required
      // here, leave the default behavior intact instead of swallowing the click.
      if (opened) event.preventDefault();
    }

    function onConsentChanged() {
      // WCP fires this when the visitor changes their choices. Reload so the new
      // consent is applied consistently across any consent-gated behavior.
      window.setTimeout(function () {
        window.location.reload();
      }, 0);
    }

    function ensureBannerPlaceholder() {
      var id = 'wcp-cookie-banner';
      var placeholder = document.getElementById(id);
      if (placeholder) return placeholder;
      if (!document.body) return null;
      placeholder = document.createElement('div');
      placeholder.id = id;
      placeholder.setAttribute('data-astro-transition-persist', id);
      // Dedicated placeholder pinned to the top of the viewport. WCP injects its
      // banner INTO this element in normal flow, so without a top-anchored host the
      // banner lands wherever the host sits. Using document.body dropped it at the
      // very bottom of the page (invisible on load) which fails the compliance scan.
      // A fixed, full-width, top strip guarantees the standard banner is visible on
      // load regardless of scroll position or the site's own sticky header.
      placeholder.style.position = 'fixed';
      placeholder.style.top = '0';
      placeholder.style.left = '0';
      placeholder.style.width = '100%';
      placeholder.style.zIndex = '2147483647';
      document.body.insertBefore(placeholder, document.body.firstChild);
      return placeholder;
    }

    function preserveConsentStyles(nextDocument) {
      var themeStyle = document.getElementById('ms-consent-banner-theme-styles');
      if (!themeStyle) return;
      // WCP's base stylesheet uses generated class names. Its theme stylesheet
      // targets those same classes, so identify the vendor styles without
      // hardcoding hashes or retaining unrelated page styles across navigation.
      var selectors = [];
      if (themeStyle.sheet) {
        var rules = themeStyle.sheet.cssRules;
        for (var i = 0; i < rules.length; i++) {
          if (rules[i].selectorText) {
            selectors.push(rules[i].selectorText);
          }
        }
      }
      document.head.querySelectorAll('style').forEach(function (style) {
        if (
          style === themeStyle ||
          selectors.some(function (selector) {
            return style.textContent.indexOf(selector) !== -1;
          })
        ) {
          // Astro recognizes equal style content and retains the original node.
          nextDocument.head.appendChild(style.cloneNode(true));
        }
      });
    }

    function preserveConsentBeforeSwap(event) {
      var nextDocument = event.newDocument;
      if (!nextDocument) return;
      preserveConsentStyles(nextDocument);

      // WCP owns this DOM and retains references/listeners inside it. Supply a
      // matching destination so ClientRouter moves the actual host, not a clone
      // of the banner or a newly initialized consent instance.
      var placeholder = document.getElementById('wcp-cookie-banner');
      if (placeholder && nextDocument.body) {
        var nextPlaceholder = nextDocument.getElementById(placeholder.id);
        if (nextPlaceholder) nextPlaceholder.remove();
        nextDocument.body.prepend(placeholder.cloneNode(false));
      }

      // ClientRouter keeps <html> but replaces its attributes. Carry only the
      // consent-owned state into that swap, leaving the next page's state alone.
      nextDocument.documentElement.toggleAttribute(
        'data-consent-not-required',
        document.documentElement.hasAttribute('data-consent-not-required')
      );
      var height = document.documentElement.style.getPropertyValue('--wcp-banner-height');
      if (height) {
        nextDocument.documentElement.style.setProperty('--wcp-banner-height', height);
      }
    }

    function applyBannerHeight() {
      var placeholder = document.getElementById('wcp-cookie-banner');
      if (!placeholder) return;
      document.documentElement.style.setProperty(
        '--wcp-banner-height',
        (placeholder.offsetHeight || 0) + 'px'
      );
    }

    // While WCP's banner is visible it sits in a fixed, full-width strip at the top
    // of the viewport (see ensureBannerPlaceholder). Publish its live height as a
    // custom property so CSS can push the fixed site header + content down by
    // exactly that much instead of letting the banner overlay them. Tracks wraps
    // and viewport resizes; collapses back to 0 when WCP removes the banner.
    function trackBannerHeight() {
      try {
        var placeholder = document.getElementById('wcp-cookie-banner');
        if (
          !placeholder ||
          window.__aspireWcpBannerObserver ||
          typeof ResizeObserver === 'undefined'
        ) {
          return;
        }
        var observer = new ResizeObserver(applyBannerHeight);
        observer.observe(placeholder);
        window.__aspireWcpBannerObserver = observer;
        applyBannerHeight();
      } catch (e) {}
    }

    // WCP paints the banner AND the preferences dialog from the theme passed at
    // init time and does not re-read the site theme on its own. WCP exposes no
    // `theme-changed` event — its only supported runtime re-theme hook is
    // `siteConsent.applyTheme(name)`, whose argument is the string theme KEY (it
    // looks the theme up in its internal map by that key). Our CSS overrides
    // already re-theme the visible surfaces instantly from custom properties;
    // calling applyTheme keeps WCP's own internal nodes in sync on theme toggles.
    function resolveWcpTheme(themeName) {
      // Resolve the site's data-theme to the WCP theme KEY. Both applyTheme and
      // init expect this string ('dark' | 'light'); passing a wcp.themes[...]
      // OBJECT instead makes applyTheme do `this.themes[object]` -> undefined ->
      // "Theme not found error" (silently swallowed), so the re-theme never runs.
      return (themeName || '').toLowerCase() === 'dark' ? 'dark' : 'light';
    }

    function applyWcpTheme() {
      // applyTheme takes the string theme key and throws on an unknown key;
      // withSiteConsent swallows that so a renamed/absent theme can't break the
      // observer.
      withSiteConsent(function (siteConsent) {
        if (typeof siteConsent.applyTheme === 'function') {
          siteConsent.applyTheme(
            resolveWcpTheme(document.documentElement.getAttribute('data-theme'))
          );
        }
      });
    }

    function watchThemeChanges() {
      try {
        if (window.__aspireWcpThemeObserver || !document.documentElement) return;
        var observer = new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            if (mutations[i].attributeName === 'data-theme') {
              applyWcpTheme();
              break;
            }
          }
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
        window.__aspireWcpThemeObserver = observer;
      } catch (e) {}
    }

    function initWcpConsent() {
      var wcp = window.WcpConsent;
      if (!wcp || typeof wcp.init !== 'function') {
        if (++initAttempts >= MAX_INIT_ATTEMPTS) return; // give up; page stays fully functional
        window.setTimeout(initWcpConsent, 100);
        return;
      }

      try {
        var culture = toCulture(document.documentElement.lang || navigator.language || 'en-US');
        // The string theme key WCP's init expects as its 5th argument. (The
        // current CDN build ignores this arg; our CSS overrides theme the visible
        // surfaces regardless, and applyWcpTheme() re-syncs WCP's own nodes on
        // later theme toggles.)
        var theme = resolveWcpTheme(document.documentElement.getAttribute('data-theme'));
        var host = ensureBannerPlaceholder() || document.body;
        trackBannerHeight();

        wcp.init(
          culture,
          host,
          function (err, siteConsent) {
            if (err || !siteConsent) return;
            window.__aspireWcpSiteConsent = siteConsent;
            setConsentRequirementState(!!siteConsent.isConsentRequired);
            applyWcpTheme();
            // Bridge WCP consent to our inert analytics scripts. onConsentChanged
            // reloads, so a later grant is re-applied by this same path on re-init.
            applyConsentToScripts(siteConsent);
          },
          // Single registration: passing onConsentChanged as init's 4th argument
          // registers it once. WCP stores consent callbacks in a LIST, so ALSO
          // calling siteConsent.onConsentChanged(onConsentChanged) would fire it
          // twice (two reloads per change).
          onConsentChanged,
          theme
        );
      } catch (e) {
        // Never let consent initialization break page rendering. Retry within
        // the bounded window in case WCP delivered a transient or partial payload.
        if (++initAttempts < MAX_INIT_ATTEMPTS) {
          window.setTimeout(initWcpConsent, 100);
        }
      }
    }

    document.addEventListener('click', openManageConsent);
    document.addEventListener('astro:before-swap', preserveConsentBeforeSwap);
    document.addEventListener('astro:after-swap', applyBannerHeight);
    watchThemeChanges();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWcpConsent, { once: true });
    } else {
      initWcpConsent();
    }
  })();
</script><!-- WebMCP: register a single `search-aspire-docs` tool for in-page agents. --><script type="module" src="/_astro/Head.astro_astro_type_script_index_1_lang.BVubSW2n.js"></script><script type="module" src="/_astro/Head.astro_astro_type_script_index_2_lang.8AkcBaSU.js"></script><script type="module" src="/_astro/AccessibleCodeButtons.astro_astro_type_script_index_0_lang.b4xLYimy.js"></script><script>
	window.StarlightThemeProvider = (() => {
		const storedTheme =
			typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
		const theme =
			storedTheme ||
			(window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
		return {
			updatePickers(theme = storedTheme || 'auto') {
				document.querySelectorAll('starlight-theme-select').forEach((picker) => {
					const select = picker.querySelector('select');
					if (select) select.value = theme;
					/** @type {HTMLTemplateElement | null} */
					const tmpl = document.querySelector(`#theme-icons`);
					const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
					if (newIcon) {
						const oldIcon = picker.querySelector('svg.label-icon');
						if (oldIcon) {
							oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
						}
					}
				});
			},
		};
	})();
</script><template id="theme-icons"><svg aria-hidden="true" class="light astro-n5k4ipy7" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;"><path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"/></svg><svg aria-hidden="true" class="dark astro-n5k4ipy7" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;"><path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"/></svg><svg aria-hidden="true" class="auto astro-n5k4ipy7" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;"><path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"/></svg></template><script>
  window.StarlightKbdProvider = (() => {
    const detectorRegexs = { apple: /mac|ipad|iphone/i, linux: /linux/i, windows: /win/i }
    return {
      matchedType: null,
      updateKbdPickers(type) {
        for (const select of document.querySelectorAll('starlight-kbd-picker select')) {
          let detectors = {}
          let isKnownType = false
          for (const option of Array.from(select.options)) {
            if (option.value === type) isKnownType = true
            const detector = option.dataset['detector']
            if (detector) detectors[detector] = option.value
          }
          if (isKnownType) {
            select.value = type
            continue
          } else if (this.matchedType) {
            select.value = this.matchedType
            continue
          }
          const platform = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent
          for (const [detector, type] of Object.entries(detectors)) {
            const detectorRegex = detectorRegexs[detector]
            if (!detectorRegex) continue
            if (detectorRegex.test(platform)) {
              this.matchedType = type
              select.value = type
              break
            }
          }
        }
      },
    }
  })()
</script><link rel="stylesheet" href="/_astro/print.ehPL0gv-.css" media="print"><link rel="stylesheet" href="/_astro/page-ssr.BXCro1Yh.css"><link rel="stylesheet" href="/_astro/middleware.DMiw7N9e.css"><style>:root .map:where(.astro-phm274gd){--pad-min:1rem;--pad-max:14rem;--w-min:480px;--w-max:1024px}.map:where(.astro-phm274gd) img{max-width:100%;height:auto}.map:where(.astro-phm274gd){background-color:color-mix(in srgb, var(--sl-color-bg) 90%, black);border:1px solid var(--sl-color-gray-5);box-shadow:var(--sl-shadow-sm);text-align:center;padding-block:1rem;padding-inline:clamp(var(--pad-min), calc(var(--pad-min) + (var(--pad-max) - var(--pad-min)) * ((100vw - var(--w-min)) / (var(--w-max) - var(--w-min)))), var(--pad-max));border-radius:.5rem}
