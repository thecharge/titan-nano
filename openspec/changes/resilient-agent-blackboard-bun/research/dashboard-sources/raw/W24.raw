<li class="toc-h4 nav-item toc-entry"><a class="reference internal nav-link" href="#jupyter_server.auth.Authorizer"><code class="docutils literal notranslate"><span class="pre">Authorizer</span></code></a><ul class="nav section-nav flex-column">
<li class="toc-h5 nav-item toc-entry"><a class="reference internal nav-link" href="#jupyter_server.auth.Authorizer.is_authorized"><code class="docutils literal notranslate"><span class="pre">Authorizer.is_authorized()</span></code></a></li>
</ul>
</li>
</ul>
</li>
</ul>
