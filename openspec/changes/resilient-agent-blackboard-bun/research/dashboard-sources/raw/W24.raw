<li class="toc-h5 nav-item toc-entry"><a class="reference internal nav-link" href="#jupyter_server.auth.IdentityProvider.get_user"><code class="docutils literal notranslate"><span class="pre">IdentityProvider.get_user()</span></code></a></li>
<li class="toc-h5 nav-item toc-entry"><a class="reference internal nav-link" href="#jupyter_server.auth.IdentityProvider.identity_model"><code class="docutils literal notranslate"><span class="pre">IdentityProvider.identity_model()</span></code></a></li>
