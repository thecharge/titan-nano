"description\":\"$undefined\",\"children\":[{\"$id\":\"docs:index.mdx\",\"type\":\"page\",\"name\":\"Overview\",\"description\":\"Langfuse is an open-source AI engineering platform (GitHub) that helps teams collaboratively debug, analyze, and iterate on their AI agent applications. All platform features are natively integrated to accelerate the development workflow.\",\"icon\":\"$undefined\",\"url\":\"/docs\",\"$ref\":\"index.mdx\"},{\"$id\":\"docs:_0\",\"type\":\"separator\",\"icon\":\"$undefined\",\"name\":\"Get Started with\"},{\"$id\":\"docs:_1\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Tracing\",\"url\":\"/docs/observability/get-started\",\"external\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"Prompt \u0026 Skill Management\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"docs:_2\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Prompt Management\",\"url\":\"/docs/prompt-management/get-started\",\"external\":\"$undefined\"},{\"$id\":\"docs:_3\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Skill Management\",\"url\":\"/docs/skill-management/get-started\",\"external\":\"$undefined\"}],\"$id\":\"docs:get-started-with-prompt-and-skill-management\",\"$ref\":{\"folder\":\"get-started-with-prompt-and-skill-management\",\"meta\":\"get-started-with-prompt-and-skill-management/meta.json\"},\"icon\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"Evals\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"docs:_4\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Evaluate Production Traffic\",\"url\":\"/docs/evaluation/get-started/online\",\"external\":\"$undefined\"},{\"$id\":\"docs:_5\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Evaluate with Datasets\",\"url\":\"/docs/evaluation/get-started/offline\",\"external\":\"$undefined\"}],\"$id\":\"docs:get-started-with-evals\",\"$ref\":{\"folder\":\"get-started-with-evals\",\"meta\":\"get-started-with-evals/meta.json\"},\"icon\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"AI Gateway\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"docs:_6\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Set up Gateway as an admin\",\"url\":\"/docs/gateway/get-started/admin-setup\",\"external\":\"$undefined\"},{\"$id\":\"docs:_7\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Send your first request\",\"url\":\"/docs/gateway/get-started/first-request\",\"external\":\"$undefined\"}],\"$id\":\"docs:get-started-with-gateway\",\"$ref\":{\"folder\":\"get-started-with-gateway\",\"meta\":\"get-started-with-gateway/meta.json\"},\"icon\":\"$undefined\"},{\"$id\":\"docs:_8\",\"type\":\"separator\",\"icon\":\"$undefined\",\"name\":\"Products\"},{\"type\":\"folder\",\"name\":\"Observability\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"docs:observability/overview.mdx\",\"type\":\"page\",\"name\":\"Overview\",\"description\":\"Open source application tracing and observability for LLM apps. Capture traces, monitor latency, track costs, and debug issues across OpenAI, LangChain, LlamaIndex, and more.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/overview\",\"$ref\":\"observability/overview.mdx\"},{\"$id\":\"docs:observability/get-started.mdx\",\"type\":\"page\",\"name\":\"Get Started\",\"description\":\"Get started with LLM observability with Langfuse in minutes before diving into all platform features.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/get-started\",\"$ref\":\"observability/get-started.mdx\"},{\"$id\":\"docs:observability/data-model.mdx\",\"type\":\"page\",\"name\":\"Concepts\",\"description\":\"Langfuse (open source) helps you trace and analyze LLM applications. Learn how traces and observations are structured in Langfuse.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/data-model\",\"$ref\":\"observability/data-model.mdx\"},{\"$id\":\"docs:observability/best-practices.mdx\",\"type\":\"page\",\"name\":\"Best Practices\",\"description\":\"Best practices for structuring Langfuse traces — scope, nesting, naming, input/output, and attributes — so that debugging, evaluation, and cost tracking work well.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/best-practices\",\"$ref\":\"observability/best-practices.mdx\"},{\"type\":\"folder\",\"name\":\"Features\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"docs:_9\",\"type\":\"separator\",\"icon\":\"$undefined\",\"name\":\"Essential\"},{\"$id\":\"docs:observability/features/sessions.mdx\",\"type\":\"page\",\"name\":\"Sessions\",\"description\":\"Track LLM chat conversations or threads across multiple observations and traces into a single session. Replay the entire interaction to debug or analyze the conversation.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/sessions\",\"$ref\":\"observability/features/sessions.mdx\"},{\"$id\":\"docs:observability/features/users.mdx\",\"type\":\"page\",\"name\":\"User Tracking\",\"description\":\"User-level LLM observability to track token usage, usage volume and individual user feedback.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/users\",\"$ref\":\"observability/features/users.mdx\"},{\"$id\":\"docs:observability/features/environments.mdx\",\"type\":\"page\",\"name\":\"Environments\",\"description\":\"Configure environments to organize your traces, observations, and scores.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/environments\",\"$ref\":\"observability/features/environments.mdx\"},{\"$id\":\"docs:observability/features/tags.mdx\",\"type\":\"page\",\"name\":\"Tags\",\"description\":\"Tags help to filter and organize traces and observations in Langfuse based on use case, functions/apis used, environment and other criteria.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/tags\",\"$ref\":\"observability/features/tags.mdx\"},{\"$id\":\"docs:observability/features/metadata.mdx\",\"type\":\"page\",\"name\":\"Metadata\",\"description\":\"Add custom metadata to your observations to better understand and correlate your observations\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/metadata\",\"$ref\":\"observability/features/metadata.mdx\"},{\"$id\":\"docs:observability/features/trace-ids-and-distributed-tracing.mdx\",\"type\":\"page\",\"name\":\"Trace IDs \u0026 Distributed Tracing\",\"description\":\"Use custom trace IDs and tracer IDs for distributed tracing in Langfuse. Link traces across services, use deterministic IDs, and integrate with your existing tracing infrastructure.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/trace-ids-and-distributed-tracing\",\"$ref\":\"observability/features/trace-ids-and-distributed-tracing.mdx\"},{\"$id\":\"docs:_10\",\"type\":\"separator\",\"icon\":\"$undefined\",\"name\":\"Advanced\"},{\"$id\":\"docs:observability/features/alerts.mdx\",\"type\":\"page\",\"name\":\"Alerts\",\"description\":\"Set threshold-based alerts on your LLM application metrics and route notifications through automations when thresholds are breached.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/alerts\",\"$ref\":\"observability/features/alerts.mdx\"},{\"$id\":\"docs:observability/features/agentic-access.mdx\",\"type\":\"page\",\"name\":\"Agent Access\",\"description\":\"Let AI agents investigate observations, query metrics, and work with your Langfuse observability data through the Agent Skill, CLI, or MCP server.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/agentic-access\",\"$ref\":\"observability/features/agentic-access.mdx\"},{\"$id\":\"docs:observability/features/comments.mdx\",\"type\":\"page\",\"name\":\"Comments\",\"description\":\"Add contextual comments to traces, observations, sessions, and prompts in Langfuse for team collaboration.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/comments\",\"$ref\":\"observability/features/comments.mdx\"},{\"$id\":\"docs:observability/features/corrections.mdx\",\"type\":\"page\",\"name\":\"Corrections\",\"description\":\"Capture improved versions of LLM outputs directly in traces and observations to build better datasets and drive continuous improvement.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/corrections\",\"$ref\":\"observability/features/corrections.mdx\"},{\"$id\":\"docs:observability/features/user-feedback.mdx\",\"type\":\"page\",\"name\":\"User Feedback\",\"description\":\"Collect user feedback on LLM or agent outputs to improve model performance and user satisfaction.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/user-feedback\",\"$ref\":\"observability/features/user-feedback.mdx\"},{\"$id\":\"docs:observability/features/log-levels.mdx\",\"type\":\"page\",\"name\":\"Log Levels\",\"description\":\"Use Log Levels to control the verbosity of your logs and highlight errors and warnings.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/log-levels\",\"$ref\":\"observability/features/log-levels.mdx\"},{\"$id\":\"docs:observability/features/agent-graphs.mdx\",\"type\":\"page\",\"name\":\"Agent Graphs\",\"description\":\"Visualize and analyze complex agent workflows with Langfuse's agent graph view — as an aggregated overview or an expanded, as-it-ran DAG.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/agent-graphs\",\"$ref\":\"observability/features/agent-graphs.mdx\"},{\"$id\":\"docs:observability/features/filter-search-bar.mdx\",\"type\":\"page\",\"name\":\"Filter Search Bar\",\"description\":\"Filter and search traces and observations by typing — fields, operators, wildcards, aliases, and full-text search in one query bar with autocomplete.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/filter-search-bar\",\"$ref\":\"observability/features/filter-search-bar.mdx\"},{\"$id\":\"docs:observability/features/events-table-charts.mdx\",\"type\":\"page\",\"name\":\"Chart any table\",\"description\":\"Toggle the Observations table into a chart over the same query. Pick a chart type, metric, aggregation, and breakdown, then add the chart to a dashboard.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/events-table-charts\",\"$ref\":\"observability/features/events-table-charts.mdx\"},{\"$id\":\"docs:observability/features/pulse.mdx\",\"type\":\"page\",\"name\":\"Pulse\",\"description\":\"A compact outlier chart strip above the Observations table. See count, cost, and latency spikes over time, then click or drag a spike to narrow the table to that window.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/pulse\",\"$ref\":\"observability/features/pulse.mdx\"},{\"$id\":\"docs:observability/features/full-text-search.mdx\",\"type\":\"page\",\"name\":\"Full-Text Search\",\"description\":\"Find content across the inputs, outputs, and metadata of your traces and observations with full-text search in Langfuse.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/full-text-search\",\"$ref\":\"observability/features/full-text-search.mdx\"},{\"$id\":\"docs:observability/features/masking.mdx\",\"type\":\"page\",\"name\":\"Masking\",\"description\":\"Configure masking to redact sensitive information from Langfuse SDK data and OpenTelemetry span attributes before they are sent to Langfuse.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/masking\",\"$ref\":\"observability/features/masking.mdx\"},{\"$id\":\"docs:observability/features/mcp-tracing.mdx\",\"type\":\"page\",\"name\":\"MCP Tracing\",\"description\":\"End-to-end tracing of MCP clients and servers with Langfuse.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/mcp-tracing\",\"$ref\":\"observability/features/mcp-tracing.mdx\"},{\"$id\":\"docs:observability/features/multi-modality.mdx\",\"type\":\"page\",\"name\":\"Multi-Modality\",\"description\":\"Langfuse fully supports multi-modal LLM traces, including text, images, audio, and attachments.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/multi-modality\",\"$ref\":\"observability/features/multi-modality.mdx\"},{\"$id\":\"docs:observability/features/observation-types.mdx\",\"type\":\"page\",\"name\":\"Observation Types\",\"description\":\"Structured tracing with observation types in Langfuse\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/observation-types\",\"$ref\":\"observability/features/observation-types.mdx\"},{\"$id\":\"docs:observability/features/queuing-batching.mdx\",\"type\":\"page\",\"name\":\"Event queuing/batching\",\"description\":\"Queuing/batching configuration for Langfuse Tracing.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/queuing-batching\",\"$ref\":\"observability/features/queuing-batching.mdx\"},{\"$id\":\"docs:observability/features/releases-and-versioning.mdx\",\"type\":\"page\",\"name\":\"Releases \u0026 Versioning\",\"description\":\"Langfuse allows for rapid iteration on LLM applications by providing insights into the effect of experiments such as A/B tests on LLM costs, latencies and quality.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/releases-and-versioning\",\"$ref\":\"observability/features/releases-and-versioning.mdx\"},{\"$id\":\"docs:observability/features/sampling.mdx\",\"type\":\"page\",\"name\":\"Sampling\",\"description\":\"Configure sampling to control the volume of traces collected by the Langfuse server.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/sampling\",\"$ref\":\"observability/features/sampling.mdx\"},{\"$id\":\"docs:observability/features/token-and-cost-tracking.mdx\",\"type\":\"page\",\"name\":\"Token \u0026 Cost Tracking\",\"description\":\"Langfuse tracks usage and cost of LLM generations for various models (incl OpenAI, Anthropic, Google, and more). You can always add your own models.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/token-and-cost-tracking\",\"$ref\":\"observability/features/token-and-cost-tracking.mdx\"},{\"$id\":\"docs:observability/features/url.mdx\",\"type\":\"page\",\"name\":\"Trace URLs\",\"description\":\"Each trace has a unique URL that you can use to share it with others or to access it directly.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/url\",\"$ref\":\"observability/features/url.mdx\"},{\"$id\":\"docs:observability/features/web-callouts.mdx\",\"type\":\"page\",\"name\":\"Web Callouts\",\"description\":\"Trigger an HTTP callout from a trace, observation, or session in Langfuse.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/features/web-callouts\",\"$ref\":\"observability/features/web-callouts.mdx\"},{\"$id\":\"docs:_11\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Query Data ↗\",\"url\":\"/docs/api-and-data-platform/overview\",\"external\":\"$undefined\"},{\"$id\":\"docs:_12\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Metrics API ↗\",\"url\":\"/docs/metrics/features/metrics-api\",\"external\":\"$undefined\"},{\"$id\":\"docs:_13\",\"type\":\"link\",\"icon\":\"$undefined\",\"name\":\"Custom Dashboards ↗\",\"url\":\"/docs/metrics/features/custom-dashboards\",\"external\":\"$undefined\"}],\"$id\":\"docs:observability/features\",\"$ref\":{\"folder\":\"observability/features\",\"meta\":\"observability/features/meta.json\"},\"icon\":\"$undefined\"},{\"type\":\"folder\",\"name\":\"SDKs\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"docs:observability/sdk/overview.mdx\",\"type\":\"page\",\"name\":\"Overview\",\"description\":\"Fully typed SDKs for Python and JavaScript/TypeScript with unified setup, instrumentation, and advanced guidance.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/sdk/overview\",\"$ref\":\"observability/sdk/overview.mdx\"},{\"$id\":\"docs:observability/sdk/instrumentation.mdx\",\"type\":\"page\",\"name\":\"Instrumentation\",\"description\":\"Use native integrations or custom instrumentation patterns in Python and JavaScript/TypeScript to capture rich traces.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/sdk/instrumentation\",\"$ref\":\"observability/sdk/instrumentation.mdx\"},{\"$id\":\"docs:observability/sdk/advanced-features.mdx\",\"type\":\"page\",\"name\":\"Advanced Features\",\"description\":\"Configure masking, logging, sampling, multi-project routing, evaluations, and environment-specific behaviors for Python and JS/TS.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/sdk/advanced-features\",\"$ref\":\"observability/sdk/advanced-features.mdx\"},{\"$id\":\"docs:observability/sdk/troubleshooting-and-faq.mdx\",\"type\":\"page\",\"name\":\"Troubleshooting \u0026 FAQ\",\"description\":\"Resolve common Python and JS/TS SDK issues with side-by-side guidance.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/sdk/troubleshooting-and-faq\",\"$ref\":\"observability/sdk/troubleshooting-and-faq.mdx\"},{\"type\":\"folder\",\"name\":\"Upgrade Path\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"docs:observability/sdk/upgrade-path/index.mdx\",\"type\":\"page\",\"name\":\"Upgrade path\",\"description\":\"Migration guides for Python SDK v4 → v5, v3 → v4, v2 → v3 and JS/TS SDK v5 → v6, v4 → v5, v3 → v4.\",\"icon\":\"$undefined\",\"url\":\"/docs/observability/sdk/upgrade-path\",\"$ref\":\"observability/sdk/upgrade-path/index.mdx\"},{\"$id\":\"docs:observability/sdk/upgrade-path/python-v4-to-v5.mdx\",\"type\":\"page\",\"name\":\"Python v4 → v5\",\"description\":\"Migra