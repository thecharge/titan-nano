nsition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"migration guide\"}],\"). Deprecated v1\\nresources moved under \",[\"$\",\"code\",null,{\"children\":\"api.legacy.*\"}],\" (Python: \",[\"$\",\"code\",null,{\"children\":\"*_v1\"}],\", JS/TS: \",[\"$\",\"code\",null,{\"children\":\"*V1\"}],\"). Python\\nSDK v5 and JS/TS SDK v6 have no \",[\"$\",\"code\",null,{\"children\":\"api.legacy\"}],\" namespace: the legacy\\nobservations and metrics read resources and \",[\"$\",\"code\",null,{\"children\":\"api.legacy.score_v1\"}],\" /\\n\",[\"$\",\"code\",null,{\"children\":\"api.legacy.scoreV1\"}],\" (including \",[\"$\",\"code\",null,{\"children\":\"create\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"delete\"}],\") are removed, as are the\\n\",[\"$\",\"code\",null,{\"children\":\"api.scores\"}],\" v2 reads. In these versions, \",[\"$\",\"code\",null,{\"children\":\"api.scores\"}],\" holds all score\\nendpoints: \",[\"$\",\"code\",null,{\"children\":\"api.scores.get_many\"}],\" / \",[\"$\",\"code\",null,{\"children\":\"api.scores.getMany\"}],\" reads Scores API v3,\\nnext to \",[\"$\",\"code\",null,{\"children\":\"create\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"delete\"}],\", and \",[\"$\",\"code\",null,{\"children\":\"api.scores_v3\"}],\" / \",[\"$\",\"code\",null,{\"children\":\"api.scoresV3\"}],\" are\\nremoved. Use \",[\"$\",\"code\",null,{\"children\":\"api.observations\"}],\", \",[\"$\",\"code\",null,{\"children\":\"api.metrics\"}],\", and \",[\"$\",\"code\",null,{\"children\":\"api.scores\"}],\"\\ninstead.\"]}],[\"$\",\"p\",null,{\"children\":[\"Observations API v2 and Metrics API v2 are available on Langfuse Cloud and\\nself-hosted Langfuse v4. On self-hosted Langfuse v3, use the \",[\"$\",\"code\",null,{\"children\":\"api.legacy.*\"}],\