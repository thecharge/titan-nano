4375 4.95619 7.4375 4.59375C7.4375 4.23131 7.14369 3.9375 6.78125 3.9375C6.41881 3.9375 6.125 4.23131 6.125 4.59375C6.125 4.95619 6.41881 5.25 6.78125 5.25Z\",\"fill\":\"currentColor\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col min-w-0 flex-1\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"text-text-secondary text-[14px] prose-no-margin empty:hidden\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Data availability:\"}],\" Data from older SDKs (\",[\"$\",\"code\",null,{\"children\":\"langfuse-python\"}],\" \u003c \",[\"$\",\"code\",null,{\"children\":\"4.7.0\"}],\", \",[\"$\",\"code\",null,{\"children\":\"langfuse-js\"}],\" \u003c \",[\"$\",\"code\",null,{\"children\":\"5.4.0\"}],\") or direct OpenTelemetry exporters that do not send \",[\"$\",\"code\",null,{\"children\":\"x-langfuse-ingestion-version: 4\"}],\" can be delayed by up to 15 minutes on v2 endpoints. Upgrade to \",[\"$\",\"$L4c\",null,{\"href\":\"/docs/observability/sdk/upgrade-path/python-v3-to-v4\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Python SDK v4.7.0+\"}],\" or \",[\"$\",\"$L4c\",null,{\"href\":\"/docs/observability/sdk/upgrade-path/js-v4-to-v5\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"JS/TS SDK v5.4.0+\"}],\", or \",[\"$\",\"$L4c\",null,{\"href\":\"/integrations/native/opentelemetry#real-time-ingestion\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"set that header on your OTEL span exporter\"}],\" to see new data in real time. Details: \",[\"$\",\"$L4c\",null,{\"href\":\"/docs/compatibility#faq-delay\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Versions \u0026 Compatibility\"}],\".\"]}],[\"$\",\"p\",null,{\"children\":[\"On self-hosted Langfuse v3, use the v1 Observations API (\",\"$L135\",\") instead; see the \",\"$L136\",\".\"]}]]}]]}]]}]}]\nba:[\"$\",\"p\",null,{\"children\":[\"The v2 Observations API is redesigned for high-performance retrieval, minimizing the work Langfuse performs per query. See the \",[\"$\",\"a\",null,{\"href\":\"https://api.reference.langfuse.com/#tag/observations/GET/api/public/v2/observations\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"v2 Observations API reference\"}],\" for the full parameter and response schema.\"]}]\nbb:[\"$\",\"$La3\",null,{\"as\":\"h4\",\"id\":\"upgrade-from-older-reads\",\"children\":\"Upgrade from older trace and observation reads\"}]\nbc:[\"$\",\"p\",null,{\"children\":[\"The \",[\"$\",\"$L4c\",null,{\"href\":\"/faq/all/deprecated-api-migration\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"migration guide\"}],\" maps every deprecated read endpoint (\",[\"$\",\"code\",null,{\"children\":\"/api/public/traces\"}],\", \",[\"$\",\"code\",null,{\"children\":\"/api/public/observations\"}],\", \",[\"$\",\"code\",null,{\"children\":\"/api/public/sessions\"}],\", ...) to its v2 replacement, with parameter mappings and before/after examples. Always include \",[\"$\",\"code\",null,{\"children\":\"fromStartTime\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"toStartTime\"}],\" to keep each request bounded.\"]}]\nbd:[\"$\",\"p\",null,{\"children\":[\"The v2 Observations API returns observation rows, not full trace objects. Group rows by \",[\"$\",\"code\",null,{\"children\":\"traceId\"}],\" when you need to reconstruct trace activity, and use \",[\"$\",\"$L4c\",null,{\"href\":\"/docs/metrics/features/metrics-api#v2\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Metrics API v2\"}],\" for aggregate reporting with trace-level dimensions such as \",[\"$\",\"code\",null,{\"children\":\"traceName\"}],\", \",[\"$\",\"code\",null,{\"children\":\"traceRelease\"}],\", or \",[\"$\",\"code\",null,{\"children\":\"traceVersion\"}],\". There is no get-by-id route on v2; for single-observation lookups, pass a URL-encoded \",[\"$\",\"code\",null,{\"children\":\"filter\"}],\" condition on the \",[\"$\",\"code\",null,{\"children\":\"id\"}],\" column instead.\"]}]\nbe:[\"$\",\"$La3\",null,{\"as\":\"h4\",\"id\":\"logical-root-observations\",\"children\":\"Logical root observations\"}]\nbf:[\"$\",\"p\",null,{\"children\":\"The v2 API distinguishes physical parentage from logical root status:\"}]\nc0:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"parentObservationId\"}],\" identifies the physical parent observation. An empty value matches observations without a physical parent.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"isRootObservation\"}],\" is \",[\"$\",\"code\",null,{\"children\":\"true\"}],\" when an observation has no physical parent or the SDK explicitly marked it as an application root.\"]}],\"\\n\"]}]\nc1:[\"$\",\"p\",null,{\"children\":[\"An application-root observation can therefore have \",[\"$\",\"code\",null,{\"children\":\"isRootObservation: true\"}],\" and a non-null \",[\"$\",\"code\",null,{\"children\":\"parentObservationId\"}],\". Use \",[\"$\",\"code\",null,{\"children\":\"isRootObservation\"}],\" when you want application roots, and \",[\"$\",\"code\",null,{\"children\":\"parentObservationId\"}],\" when you need to query the physical observation tree.\"]}]\nc2:[\"$\",\"p\",null,{\"children\":[\"The logical-root filter assumes one exported application root per trace. If a trace has no exported root in this project — for example, its root lives in another service — \",[\"$\",\"code\",null,{\"children\":\"isRootObservation = true\"}],\" will not match it; group by \",[\"$\",\"code\",null,{\"children\":\"traceId\"}],\" when you need complete trace counts. Multiple matching roots indicate an integration issue.\"]}]\nc3:[\"$\",\"$La3\",null,{\"as\":\"h4\",\"id\":\"field-groups\",\"children\":\"Selective field retrieval\"}]\nc4:[\"$\",\"p\",null,{\"children\":\"Rather than returning every column on every row, the v2 API lets you request only the field groups you need as a comma-separated string:\"}]\nc5:[\"$\",\"$L10f\",null,{\"className\":\"shiki s