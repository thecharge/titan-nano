ne" stroke-width="1.5" class="stroke-current/25"></circle><circle cx="9" cy="9" r="7.5" fill="none" stroke-width="1.5" stroke="currentColor" stroke-dasharray="47.12388980384689" stroke-dashoffset="47.12388980384689" stroke-linecap="round" transform="rotate(-90 9 9)" class="transition-all"></circle></svg><span class="grid flex-1 *:my-auto *:row-start-1 *:col-start-1"><span class="truncate transition-[opacity,translate,color]">Public API</span><span class="truncate transition-[opacity,translate] opacity-0 translate-y-full pointer-events-none"></span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down shrink-0 transition-transform mx-0.5" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div data-state="closed" id="radix-_R_2lubt6cnql5b_" hidden="" data-toc-popover-content="" class="overflow-hidden"></div></header></div><main class="grid [grid-area:main] justify-items-center" data-layout-main=""><article id="nd-page" data-layout-content="" data-full="false" class="flex flex-col min-w-0 w-full max-w-[900px] px-4 py-6 gap-4 md:px-6 md:pt-8 xl:px-8 xl:pt-14"><div class="flex items-center gap-1.5 text-sm text-fd-muted-foreground"><a class="truncate transition-opacity hover:opacity-80" href="/docs">Docs</a><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3.5 shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><a class="truncate transition-opacity hover:opacity-80" href="/docs/api-and-data-platform/overview">API &amp; Data Platform</a><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3.5 shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><a class="truncate transition-opacity hover:opacity-80" href="/docs/api-and-data-platform/features/agent-skill">Features</a><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3.5 shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><a class="truncate text-fd-primary font-medium transition-opacity hover:opacity-80" href="/docs/api-and-data-platform/features/public-api">Public API</a></div><div class="prose flex-1"><div class="mx-auto w-full"><div class="mb-4 flex flex-wrap gap-2 items-center sm:absolute sm:max-w-[15rem] sm:justify-end right-0 top-[-62px]"><div class="group relative inline-flex items-center p-1 button-wrapper"><span aria-hidden="true" class="corner-box-hover-child"></span><div class="inline-flex h-[26px] items-stretch overflow-hidden rounded-[1px] border border-line-structure dark:border-line-cta bg-surface-bg text-text-secondary [box-shadow:0_4px_8px_0_rgba(0,0,0,0.05),0_4px_4px_0_rgba(0,0,0,0.03)]"><button type="button" class="inline-flex items-center px-[8px] py-0.75 font-sans text-[12px] font-[450] leading-[150%] tracking-[-0.06px] [font-variant-numeric:ordinal] transition-colors min-w-[80px] max-w-[160px] overflow-hidden cursor-pointer hover:bg-surface-1/80"><span class="truncate">Copy page</span></button><button type="button" aria-label="Open copy options" class="inline-flex w-[24px] items-center justify-center border-l border-line-structure transition-colors cursor-pointer hover:bg-surface-1/80" id="radix-_R_1a5klubt6cnql5b_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-3 w-3" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div></div><h1 id="public-api" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#public-api">Public API</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h1>
<p>Langfuse is open and meant to be extended via custom workflows and integrations. All Langfuse data and features are available via the API.</p>
<div class="relative bg-surface-bg border border-line-structure corner-box-corners callout"><div class="bg-stripe-pattern callout-stripe-fade flex border p-4 gap-2 text-sm text-primary" style="--callout-color:var(--callout-info, var(--color-fd-muted));--stripe-color:var(--callout-info, var(--color-fd-muted))"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" class="size-4 mt-0.5 text-(--callout-color)"><g><path d="M7 12.25C9.8995 12.25 12.25 9.8995 12.25 7C12.25 4.10051 9.8995 1.75 7 1.75C4.10051 1.75 1.75 4.10051 1.75 7C1.75 9.8995 4.10051 12.25 7 12.25Z" stroke="currentColor" stroke-width="0.875" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6.5625 6.5625C6.67853 6.5625 6.78981 6.60859 6.87186 6.69064C6.95391 6.77269 7 6.88397 7 7V9.1875C7 9.30353 7.04609 9.41481 7.12814 9.49686C7.21019 9.57891 7.32147 9.625 7.4375 9.625" stroke="currentColor" stroke-width="0.875" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6.78125 5.25C7.14369 5.25 7.4375 4.95619 7.4375 4.59375C7.4375 4.23131 7.14369 3.9375 6.78125 3.9375C6.41881 3.9375 6.125 4.23131 6.125 4.59375C6.125 4.95619 6.41881 5.25 6.78125 5.25Z" fill="currentColor"></path></g></svg><div class="flex flex-col min-w-0 flex-1"><div class="text-text-secondary text-[14px] prose-no-margin empty:hidden"><p>There are 3 different groups of APIs:</p><ul>
<li>This page -&gt; Project-level APIs: CRUD traces/evals/prompts/configuration within a project</li>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/docs/administration/scim-and-org-api">Organization-level APIs</a>: provision projects, users (SCIM), and permissions</li>
<li><a class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal" href="/self-hosting/administration/instance-management-api">Instance Management API</a>: administer organizations on self-hosted installations</li>
</ul></div></div></div></div>
<h2 id="api-reference" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#api-reference">API reference</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h2>
<p>This page covers concepts and workflows. For the complete request and response contract of every endpoint — parameters, schemas, and interactive examples — see the API reference:</p>
<ul>
<li>API Reference: <a href="https://api.reference.langfuse.com" target="_blank" rel="noopener noreferrer" class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal">https://api.reference.langfuse.com</a></li>
<li>OpenAPI spec: <a href="https://cloud.langfuse.com/generated/api/openapi.yml" target="_blank" rel="noopener noreferrer" class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal">https://cloud.langfuse.com/generated/api/openapi.yml</a> (organization API: <a href="https://cloud.langfuse.com/generated/organizations-api/openapi.yml" target="_blank" rel="noopener noreferrer" class="transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal">https://cloud.langfuse.com/generated/organizations-api/openapi.yml</a>)</li>
<li>Self-hosted: every instance running Langfuse v4.36.0 or later serves its own spec at <code>/api/openapi.yaml</code> and an interactive reference at <code>/api/docs</code></li>
</ul>
<h2 id="quickstart" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#quickstart">Quickstart</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h2>
<div class="fd-steps"><h3 id="authentication" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#authentication">Obtain credentials</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h3><p>The public and secret keys are available in the Langfuse project settings.</p><h3 id="base-urls" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#base-urls">Select the regional base URL</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h3><div><div class="relative bg-surface-bg border border-line-structure corner-box-corners"><div dir="ltr" data-orientation="horizontal" class="border bg-fd-secondary flex overflow-hidden flex-col my-0 rounded-none border-none"><div role="tablist" aria-orientation="horizontal" class="text-fd-secondary-foreground not-prose flex overflow-x-auto overflow-y-hidden flex-nowrap gap-2 px-4 pt-1 rounded-none border-b sm:gap-4 not-prose border-line-structure min-h-9 bg-surface-bg" tabindex="-1" data-orientation="horizontal" style="outline:none"><button type="button" role="tab" aria-selected="true" aria-controls="radix-_R_41udklubt6cnql5b_-content-path" data-state="active" id="radix-_R_41udklubt6cnql5b_-trigger-path" class="py-2 [&amp;_svg]:size-4 inline-flex items-center gap-2 whitespace-nowrap rounded-none border-b border-transparent pb-2 pt-1.5 text-xs text-text-tertiary transition-colors font-[430] hover:text-foreground cursor-pointer disabled:pointer-events-none disabled:opacity-50 data-[state=active]:border-line-cta data-[state=active]:text-text-primary data-[state=active]:font-medium" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Path</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_R_41udklubt6cnql5b_-content-cloud-us" data-state="inactive" id="radix-_R_41udklubt6cnql5b_-trigger-cloud-us" class="py-2 [&amp;_svg]:size-4 inline-flex items-center gap-2 whitespace-nowrap rounded-none border-b border-transparent pb-2 pt-1.5 text-xs text-text-tertiary transition-colors font-[430] hover:text-foreground cursor-pointer disabled:pointer-events-none disabled:opacity-50 data-[state=active]:border-line-cta data-[state=active]:text-text-primary data-[state=active]:font-medium" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Cloud US</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_R_41