rted.mdx\",\"type\":\"page\",\"name\":\"Get Started\",\"description\":\"Get started with Langfuse Prompt Management.\",\"icon\":\"$undefined\",\"url\":\"/docs/prompt-management/get-started\",\"$ref\":\"prompt-management/get-started.mdx\"},{\"type\":\"folder\",\"name\":\"Features\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"children\":[{\"$id\":\"fallback:docs:_0\",\"type\":\"separator\",\"icon\":\"$undefined\",\"name\":\"Essential\"},{\"$id\":\"fallback:docs:prompt-management/features/link-to-traces.mdx\",\"type\":\"page\",\"name\":\"Link to Traces\",\"description\":\"Link Langfuse Prompts to Traces.\",\"icon\":\"$undefined\",\"url\":\"/docs/prompt-management/features/link-to-traces\",\"$ref\":\"prompt-management/features/link-to-traces.mdx\"},{\"$id\":\"fallback:docs:prompt-management/features/prompt-version-control.mdx\",\"type\":\"page\",\"name\":\"Version Control\",\"description\":\"Use prompt labels to fetch specific prompt versions in the SDKs.\",\"icon\":\"$undefined\",\"url\":\"/docs/prompt-management/features/prompt-version-control\",\"$ref\":\"prompt-management/features/prompt-version-control.mdx\"},{\"$id\":\"fallback:docs:prompt-management/features/playground.mdx\",\"type\":\"page\",\"name\":\"Playground\",\"description\":\"Test, iterate, and compare different prompts and models within the LLM Playground.\",\"icon\":\"$undefined\",\"url\":\"/docs/prompt-management/features/playground\",\"$ref\":\"prompt-management/features/playground.mdx\"},{\"$id\":\"fallback:docs:_1\",\"type\":\"separator\",\"icon\":\"$undefined\",\"name\":\"Advanced\"},{\"$id\":\"fallback:docs:prompt-management/features/variables.mdx\",\"type\":\"page\",\"name\":\"Variables\",\"description\":\"Insert dynamic text into prompts using variables that are resolved at runtime.\",\"icon\":\"$undefined\",\"url\":\"/docs/prompt-management/features/variables\",\"$ref\":\"prompt-management/features/variables.mdx\"},{\"$i