n-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Python SDK\"}],\" and the \",[\"$\",\"$L4c\",null,{\"href\":\"/docs/observability/sdk/overview\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"JS/TS SDK\"}],\" provide a strongly-typed wrapper around our public REST API for your convenience. The API methods are accessible via the \",[\"$\",\"code\",null,{\"children\":\"api\"}],\" property on the Langfuse client instance in both SDKs.\"]}]\naa:[\"$\",\"p\",null,{\"children\":[\"You can use your editor's Intellisense to explore the API methods and their parameters. See \",[\"$\",\"$L4c\",null,{\"href\":\"/docs/api-and-data-platform/features/query-via-sdk\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"className\":\"transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 text-text-links underline decoration-1 underline-offset-2 decoration-text-links hover:text-primary hover:decoration-primary font-normal\",\"children\":\"Query via SDKs\"}],\" for more examples.\"]}]\nab:[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"relative bg-surface-bg border border-line-structure corner-box-corners callout\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"bg-stripe-pattern callout-stripe-fade flex border p-4 gap-2 text-sm text-primary\",\"style\":{\"--callout-color\":\"var(--callout-info, var(--color-fd-muted))\",\"--stripe-color\":\"var(--callout-info, var(--color-fd-muted))\"},\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"14\",\"height\":\"14\",\"viewBox\":\"0 0 14 14\",\"fill\":\"no