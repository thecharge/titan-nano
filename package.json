{
  "name": "titan-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.10",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "testing",
      "testing/packages/*"
    ],
    "catalog": {
      "zod": "4.6.7",
      "@openai/codex-sdk": "0.167.0",
      "@anthropic-ai/claude-agent-sdk": "0.3.319",
      "@modelcontextprotocol/sdk": "1.32.2",
      "@huggingface/transformers": "4.3.2",
      "sqlite-vec": "0.1.9"
    }
  },
  "scripts": {
    "hooks:install": "lefthook install",
    "check:hooks": "lefthook validate",
    "check:message": "bun tooling/scripts/check-message.ts",
    "check:commits": "bun tooling/scripts/check-commits.ts",
    "check:staged": "bun tooling/scripts/check-hook.ts commit",
    "titan": "bun apps/cli/src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check apps packages testing tooling/scripts/*.ts",
    "format": "biome check --write .",
    "check:specs": "python3 -I tooling/scripts/check-specs.py",
    "check:scenarios": "bun tooling/scripts/check-scenarios.ts",
    "check:release": "bun tooling/scripts/check-scenarios.ts --release",
    "check:links": "bun tooling/scripts/check-document-links.ts",
    "check:docs": "bun tooling/scripts/check-docs.ts",
    "check:readmes": "bun tooling/scripts/check-readmes.ts",
    "test": "bun tooling/scripts/test-offline.ts",
    "check": "bun tooling/scripts/check.ts",
    "pack:preview": "bun tooling/scripts/pack.ts",
    "test:prepare": "bun tooling/scripts/test-image.ts",
    "check:package": "bun tooling/scripts/check-package.ts",
    "check:package-policy": "bun tooling/scripts/check-package-policy.ts",
    "check:boundaries": "bun tooling/scripts/check-boundaries.ts",
    "check:coverage": "bun tooling/scripts/check-coverage.ts",
    "check:promises": "bun tooling/scripts/check-promises.ts",
    "check:async-fs": "bun tooling/scripts/check-async-fs.ts",
    "check:unused": "bun tooling/scripts/check-unused.ts",
    "check:format:docs": "bun tooling/scripts/check-format-docs.ts",
    "format:docs": "bun x --no-install dprint fmt --config dprint.json --config-discovery=false --no-gitignore",
    "check:spelling": "bun tooling/scripts/check-spelling.ts",
    "check:typescript-policy": "bun tooling/scripts/check-typescript-policy.ts",
    "check:lint-policy": "bun tooling/scripts/check-lint-policy.ts",
    "check:schemas": "bun tooling/scripts/check-schemas.ts",
    "check:source-comments": "bun tooling/scripts/check-source-comments.ts",
    "check:flat-tests": "bun tooling/scripts/check-flat-tests.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@dprint/dockerfile": "0.7.0",
    "@dprint/markdown": "0.28.2",
    "@dprint/toml": "0.9.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@titan/config": "workspace:*",
    "@titan/constants": "workspace:*",
    "@titan/core": "workspace:*",
    "@titan/errors": "workspace:*",
    "@titan/messages": "workspace:*",
    "@titan/server": "workspace:*",
    "@titan/streams": "workspace:*",
    "@titan/types": "workspace:*",
    "@titan/workspace": "workspace:*",
    "@types/bun": "1.3.10",
    "@types/mdast": "4.0.4",
    "cspell": "10.4.0",
    "dprint": "0.64.3",
    "dprint-plugin-yaml": "0.6.0",
    "github-slugger": "2.0.0",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-string": "4.0.0",
    "secretlint": "13.1.0",
    "typescript": "5.9.3",
    "@titan/process": "workspace:*"
  },
  "patchedDependencies": {
    "@modelcontextprotocol/sdk@1.32.2": "patches/@modelcontextprotocol%2Fsdk@1.32.2.patch",
    "@openai/codex-sdk@0.167.0": "patches/@openai%2Fcodex-sdk@0.167.0.patch"
  }
}
